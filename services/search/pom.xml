<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ulticode</groupId>
        <artifactId>ulticode-backend</artifactId>
        <!-- ${revision}: reactor-wide platform version shared by api/platform modules. -->
        <version>${revision}</version>
    </parent>
    <properties>
        <!-- Authoritative release version of this owner service; bump independently
             to release it without touching other services. Cross-service test
             dependencies resolve the default copy in the root pom. -->
        <service.version.search>1.0.0</service.version.search>
    </properties>

    <artifactId>backend-search</artifactId>
    <version>${service.version.search}</version>
    <name>backend-search</name>
    <description>Indexing worker: Redis Streams SearchDocumentChanged consumer + MeiliSearch writer</description>

    <dependencies>
        <!-- DEC-011: shared event/error atoms. No app-api: the worker consumes
             the wire stream only and must stay free of business contracts. -->
        <dependency>
            <groupId>com.ulticode</groupId>
            <artifactId>backend-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- No spring-boot-starter-web: the worker exposes no HTTP surface
             (judge worker precedent: web-application-type=none). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Review 2026-08-25 P1: same OTel/Prometheus observability set as
             auth/admin/app-web (tracing bridge + OTLP exporter). The worker
             has no HTTP surface, so spans only cover the Dubbo/Redis Streams
             paths, but W3C trace context and OTLP export stay consistent. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Sole MeiliSearch index writer (same SDK version as backend-app). -->
        <dependency>
            <groupId>com.meilisearch.sdk</groupId>
            <artifactId>meilisearch-java</artifactId>
            <version>0.20.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Observability dependencies are declared above; keep this block
             free of duplicate coordinates so Maven's model remains stable. -->
</dependencies>

    <build>
        <finalName>backend-search</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.ulticode.search.SearchWorkerApplication</mainClass>
                    <!-- Keep the main artifact as a normal library so the
                         App's test-only event-to-query harness can compile
                         in the full reactor; publish the executable as -exec. -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <!-- No jacoco agent here, so the parent's @{argLine} placeholder
                 would reach the forked JVM literally and crash `java -jar`.
                 Plain attach flag is enough for ByteBuddy inline mocks
                 (backend-common precedent). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
