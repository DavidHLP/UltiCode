# Multi-stage Dockerfile for secure code execution sandbox
# Supports: JavaScript, TypeScript, Python, Java, C++, Go, Rust

FROM ubuntu:22.04 AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    build-essential \
    openjdk-17-jdk \
    python3 \
    python3-pip \
    golang-go \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
    && chmod -R 777 /usr/local/rustup /usr/local/cargo

# Create non-root user for security
RUN useradd -m -s /bin/bash judge

# Set up working directory
WORKDIR /sandbox

# Create directories for code execution
RUN mkdir -p /sandbox/code /sandbox/input /sandbox/output /sandbox/runners

# Install TypeScript for JavaScript/TypeScript runner
RUN npm init -y && npm install typescript --save \
    && chown -R judge:judge /sandbox

# Copy runner scripts (context is backend directory)
COPY judge/runners/ /sandbox/runners/
RUN chmod +x /sandbox/runners/*.sh /sandbox/runners/*.py /sandbox/runners/*.js 2>/dev/null || true

# Switch to non-root user
USER judge

# Default command
CMD ["/bin/bash"]
