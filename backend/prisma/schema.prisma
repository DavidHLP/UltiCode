generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @db.VarChar(40)
  username              String                  @unique @db.VarChar(120)
  name                  String?                 @db.VarChar(120)
  email                 String?                 @db.VarChar(255)
  avatar                String?                 @db.VarChar(255)
  password              String?                 @db.VarChar(255)
  bio                   String?                 @db.Text
  company               String?                 @db.VarChar(255)
  github                String?                 @db.VarChar(255)
  joined_at             DateTime                @default(now())
  location              String?                 @db.VarChar(255)
  twitter               String?                 @db.VarChar(255)
  website               String?                 @db.VarChar(255)
  preferred_language    String?                 @db.VarChar(50)
  role                  UserRole                @default(USER)
  is_active             Boolean                 @default(true)
  is_banned             Boolean                 @default(false)
  banned_until          DateTime?
  banned_reason         String?                 @db.Text
  last_login_at         DateTime?
  created_by            String?                 @db.VarChar(40)
  updated_by            String?                 @db.VarChar(40)
  bookmarkFolders       BookmarkFolder[]
  contestParticipants   ContestParticipant[]
  contestProblemResults ContestProblemResult[]
  contestRankings       ContestRanking[]
  edgeOperations        EdgeOperation[]
  globalRanking         GlobalRanking?
  problemNotes          ProblemNote[]
  solutionComments      SolutionComment[]
  solutions             Solution[]
  submissions           Submission[]
  views                 View[]
  virtualSessions       VirtualContestSession[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  permissions           UserPermission[]
  auditLogs             AuditLog[]              @relation("AuditLogUser")
  performedAudits       AuditLog[]              @relation("AuditLogPerformer")

  @@index([role])
  @@index([is_active, is_banned])
  @@map("users")
}

model Problem {
  id                   BigInt                       @id
  slug                 String                       @db.VarChar(120)
  title                String                       @db.VarChar(255)
  difficulty           Difficulty
  acceptance_rate      Decimal                      @default(0.00) @db.Decimal(5, 2)
  status               ProblemStatus                @default(todo)
  is_premium           Boolean                      @default(false)
  has_solution         Boolean                      @default(false)
  completed_time       DateTime?                    @db.Date
  is_published         Boolean                      @default(true)
  published_at         DateTime?
  published_by         String?                      @db.VarChar(40)
  is_deleted           Boolean                      @default(false)
  deleted_at           DateTime?
  deleted_by           String?                      @db.VarChar(40)
  contestProblems      ContestProblem[]
  detail               ProblemDetail?
  examples             ProblemExample[]
  languages            ProblemLanguage[]
  problemListRelations ProblemListProblemRelation[]
  problemNotes         ProblemNote[]
  tagRelations         ProblemTagRelation[]
  solutions            Solution[]
  submissions          Submission[]

  @@map("problems")
}

model ProblemDetail {
  id                String   @id @db.VarChar(40)
  problem_id        BigInt   @unique
  slug              String   @db.VarChar(120)
  summary           String   @db.Text
  companies         Json?
  likes             Int      @default(0)
  dislikes          Int      @default(0)
  difficulty_rating Decimal  @default(1500.0) @db.Decimal(5, 1)
  updated_at        DateTime
  follow_up         String?  @db.Text
  constraints_json  Json
  hints             Json?
  problem           Problem  @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@map("problem_details")
}

model ProblemTag {
  id               String               @id @db.VarChar(40)
  label            String               @db.VarChar(120)
  problemRelations ProblemTagRelation[]

  @@map("problem_tags")
}

model ProblemTagRelation {
  problem_id BigInt
  tag_id     String     @db.VarChar(40)
  problem    Problem    @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  tag        ProblemTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([problem_id, tag_id])
  @@index([tag_id], map: "problem_tag_relations_tag_id_fkey")
  @@map("problem_tag_relations")
}

model ProblemLanguage {
  id           String  @id @db.VarChar(40)
  problem_id   BigInt
  label        String  @db.VarChar(50)
  value        String  @db.VarChar(50)
  style        String? @db.VarChar(20)
  starter_code String  @db.Text
  problem      Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@index([problem_id], map: "problem_languages_problem_id_fkey")
  @@map("problem_languages")
}

model ProblemExample {
  id            String  @id @db.VarChar(40)
  problem_id    BigInt
  example_order Int     @default(0)
  input_text    String  @db.Text
  output_text   String  @db.Text
  explanation   String? @db.Text
  inputs        Json?
  problem       Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@index([problem_id], map: "problem_examples_problem_id_fkey")
  @@map("problem_examples")
}

model Contest {
  id                 String                 @id @db.VarChar(40)
  title              String                 @db.VarChar(120)
  slug               String                 @db.VarChar(120)
  contest_type       ContestType
  start_time         DateTime
  duration_minutes   Int
  status             ContestStatus
  penalty_per_wrong  Int                    @default(300)
  scoring_mode       ContestScoringMode     @default(SCORE)
  tie_breaker        ContestTieBreaker      @default(LAST_SOLVE_TIME)
  registered_count   Int                    @default(0)
  participant_count  Int                    @default(0)
  is_rated           Boolean                @default(true)
  description        String?                @db.Text
  cover_image        String?                @db.VarChar(255)
  created_at         DateTime               @default(now())
  created_by         String?                @db.VarChar(40)
  is_visible         Boolean                @default(true)
  rules              String?                @db.Text
  updated_at         DateTime               @updatedAt
  is_deleted         Boolean                @default(false)
  deleted_at         DateTime?
  deleted_by         String?                @db.VarChar(40)
  participants       ContestParticipant[]
  problemResults     ContestProblemResult[]
  problems           ContestProblem[]
  rankings           ContestRanking[]
  contestSubmissions ContestSubmission[]
  virtualSessions    VirtualContestSession[]

  @@index([status, start_time])
  @@index([contest_type])
  @@index([slug])
  @@map("contests")
}

model ContestProblem {
  id                 String                 @id @db.VarChar(40)
  contest_id         String                 @db.VarChar(40)
  problem_id         BigInt
  problem_index      String                 @db.VarChar(10)
  score              Int                    @default(0)
  penalty_per_wrong  Int?
  solved_count       Int                    @default(0)
  submission_count   Int                    @default(0)
  problemResults     ContestProblemResult[]
  contest            Contest                @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  problem            Problem                @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  contestSubmissions ContestSubmission[]

  @@index([contest_id])
  @@index([problem_id], map: "contest_problems_problem_id_fkey")
  @@map("contest_problems")
}

model GlobalRanking {
  id                String      @id @db.VarChar(40)
  user_id           String      @unique @db.VarChar(40)
  username          String      @db.VarChar(120)
  global_rank       Int
  rating            Int         @default(1500)
  max_rating        Int         @default(1500)
  contests_attended Int         @default(0)
  avatar            String?     @db.VarChar(255)
  country           String?     @db.VarChar(10)
  badge             String?     @db.VarChar(50)
  contests_rated    Int         @default(0)
  last_contest_id   String?     @db.VarChar(40)
  max_rating_title  RatingTitle @default(NEWBIE)
  rating_title      RatingTitle @default(NEWBIE)
  updated_at        DateTime    @updatedAt
  user              User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([global_rank])
  @@index([rating])
  @@map("global_rankings")
}

model ContestRanking {
  id                     String                 @id @db.VarChar(40)
  contest_id             String                 @db.VarChar(40)
  user_id                String                 @db.VarChar(40)
  rank                   Int
  rating_before          Int                    @default(1500)
  rating_after           Int                    @default(1500)
  rating_change          Int                    @default(0)
  is_virtual             Boolean                @default(false)
  solved_count           Int                    @default(0)
  total_penalty          Int                    @default(0)
  total_score            Int                    @default(0)
  finish_time            Int?
  total_attempts         Int                    @default(0)
  problem_stats_snapshot Json?
  problemResults         ContestProblemResult[]
  contest                Contest                @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([contest_id, user_id, is_virtual])
  @@index([contest_id, rank])
  @@index([user_id])
  @@map("contest_rankings")
}

model ContestParticipant {
  id                 String                   @id @db.VarChar(40)
  contest_id         String                   @db.VarChar(40)
  user_id            String                   @db.VarChar(40)
  status             ContestParticipantStatus @default(REGISTERED)
  registered_at      DateTime                 @default(now())
  started_at         DateTime?
  finished_at        DateTime?
  is_virtual         Boolean                  @default(false)
  final_rank         Int?
  total_penalty      Int                      @default(0)
  total_score        Int                      @default(0)
  total_attempts     Int                      @default(0)
  last_solve_time    Int?
  virtual_session_id String?                  @db.VarChar(40)
  contest            Contest                  @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  user               User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  virtualSession     VirtualContestSession?   @relation(fields: [virtual_session_id], references: [id])
  problemResults     ContestProblemResult[]
  contestSubmissions ContestSubmission[]

  @@unique([contest_id, user_id, virtual_session_id])
  @@index([user_id])
  @@index([contest_id, final_rank])
  @@index([virtual_session_id], map: "contest_participants_virtual_session_id_fkey")
  @@map("contest_participants")
}

model ContestProblemResult {
  id                 String             @id @default(uuid()) @db.VarChar(40)
  contest_id         String             @db.VarChar(40)
  contest_problem_id String             @db.VarChar(40)
  user_id            String             @db.VarChar(40)
  participant_id     String             @db.VarChar(40)
  ranking_id         String?            @db.VarChar(40)
  is_solved          Boolean            @default(false)
  score              Int                @default(0)
  attempts           Int                @default(0)
  first_solve_time   Int?
  penalty_time       Int                @default(0)
  best_submission_id String?            @db.VarChar(40)
  contest            Contest            @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  contestProblem     ContestProblem     @relation(fields: [contest_problem_id], references: [id], onDelete: Cascade)
  participant        ContestParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  ranking            ContestRanking?    @relation(fields: [ranking_id], references: [id])
  user               User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([participant_id, contest_problem_id])
  @@index([contest_id, user_id])
  @@index([contest_problem_id])
  @@index([ranking_id], map: "contest_problem_results_ranking_id_fkey")
  @@index([user_id], map: "contest_problem_results_user_id_fkey")
  @@map("contest_problem_results")
}

model VirtualContestSession {
  id            String               @id @default(uuid()) @db.VarChar(40)
  contest_id    String               @db.VarChar(40)
  user_id       String               @db.VarChar(40)
  status        VirtualContestStatus @default(NOT_STARTED)
  started_at    DateTime?
  ends_at       DateTime?
  finished_at   DateTime?
  total_score   Int                  @default(0)
  total_penalty Int                  @default(0)
  participants  ContestParticipant[]
  user          User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contest       Contest              @relation(fields: [contest_id], references: [id], onDelete: Cascade)

  @@index([contest_id, user_id])
  @@index([user_id, status])
  @@map("virtual_contest_sessions")
}

model ContestSubmission {
  id                 String             @id @default(uuid()) @db.VarChar(40)
  submission_id      String             @db.VarChar(40)
  contest_id         String             @db.VarChar(40)
  contest_problem_id String             @db.VarChar(40)
  participant_id     String             @db.VarChar(40)
  virtual_session_id String?            @db.VarChar(40)
  submitted_at       DateTime           @default(now())
  time_from_start    Int
  is_accepted        Boolean            @default(false)
  contest            Contest            @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  contestProblem     ContestProblem     @relation(fields: [contest_problem_id], references: [id], onDelete: Cascade)
  participant        ContestParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  submission         Submission         @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@index([contest_id, participant_id])
  @@index([contest_problem_id])
  @@index([participant_id], map: "contest_submissions_participant_id_fkey")
  @@index([submission_id], map: "contest_submissions_submission_id_fkey")
  @@map("contest_submissions")
}

model NotificationPreference {
  id             String   @id @default(uuid()) @db.VarChar(40)
  user_id        String   @unique @db.VarChar(40)
  communication  Boolean  @default(true)
  marketing      Boolean  @default(false)
  security       Boolean  @default(true)
  system         Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id          String               @id @default(uuid()) @db.VarChar(40)
  user_id     String               @db.VarChar(40)
  type        NotificationType
  category    NotificationCategory
  title       String               @db.VarChar(255)
  body        String               @db.Text
  link        String?              @db.VarChar(255)
  metadata    Json?
  is_read     Boolean              @default(false)
  read_at     DateTime?
  created_at  DateTime             @default(now())
  updated_at  DateTime             @updatedAt
  user        User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@index([user_id, type])
  @@map("notifications")
}

model ForumCommunity {
  id          String                     @id @db.VarChar(40)
  name        String                     @db.VarChar(120)
  slug        String                     @unique @db.VarChar(60)
  description String                     @db.Text
  members     Int                        @default(0)
  online      Int                        @default(0)
  icon        String?                    @db.VarChar(255)
  color       String?                    @db.VarChar(20)
  banner      String?                    @db.VarChar(255)
  posts_count Int                        @default(0)
  posts_today Int                        @default(0)
  posts_week  Int                        @default(0)
  is_official Boolean                    @default(false)
  is_featured Boolean                    @default(false)
  sort_order  Int                        @default(0)
  created_at  DateTime                   @default(now())
  visibility  CommunityVisibility        @default(PUBLIC)
  links       ForumCommunityLink[]
  members_rel ForumCommunityMember[]
  permissions ForumCommunityPermission[]
  rules       ForumCommunityRule[]
  tags        ForumCommunityTag[]
  posts       ForumPost[]

  @@index([slug])
  @@index([visibility, is_featured])
  @@map("forum_communities")
}

model ForumUser {
  username String         @unique @db.VarChar(60)
  avatar   String?        @db.VarChar(255)
  karma    Int            @default(0)
  id       String         @id @db.VarChar(40)
  comments ForumComment[]
  posts    ForumPost[]

  @@map("forum_users")
}

model ForumPost {
  id             String                 @id @db.VarChar(40)
  community_id   String                 @db.VarChar(40)
  user_id        String                 @db.VarChar(40)
  permalink      String?                @db.VarChar(255)
  title          String                 @db.VarChar(255)
  flair_type     FlairType?
  flair_label    String?                @db.VarChar(60)
  tags           Json
  excerpt        String?                @db.Text
  media          Json?
  recommendation Json?
  vote_state     VoteState              @default(neutral)
  is_saved       Boolean                @default(false)
  impressions    Int                    @default(0)
  is_pinned      Boolean                @default(false)
  is_locked      Boolean                @default(false)
  created_at     DateTime
  stats          Json?
  views          Int                    @default(0)
  is_flagged     Boolean                @default(false)
  flagged_reason String?                @db.Text
  flagged_at     DateTime?
  is_deleted     Boolean                @default(false)
  deleted_at     DateTime?
  deleted_by     String?                @db.VarChar(40)
  comments       ForumComment[]
  tag_relations  ForumPostTagRelation[]
  community      ForumCommunity         @relation(fields: [community_id], references: [id], onDelete: Cascade)
  author         ForumUser              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([community_id], map: "forum_posts_community_id_fkey")
  @@index([user_id], map: "forum_posts_user_id_fkey")
  @@map("forum_posts")
}

model ForumComment {
  id         String         @id @db.VarChar(40)
  post_id    String         @db.VarChar(40)
  parent_id  String?        @db.VarChar(40)
  author_id  String         @db.VarChar(40)
  body       String         @db.Text
  markdown   String?        @db.Text
  created_at DateTime
  edited_at  DateTime?
  is_pinned  Boolean        @default(false)
  is_locked  Boolean        @default(false)
  author     ForumUser      @relation(fields: [author_id], references: [id], onDelete: Cascade)
  parent     ForumComment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies    ForumComment[] @relation("CommentReplies")
  post       ForumPost      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  is_flagged     Boolean   @default(false)
  flagged_reason String?   @db.Text
  flagged_at     DateTime?
  is_deleted     Boolean   @default(false)
  deleted_at     DateTime?
  deleted_by     String?   @db.VarChar(40)

  @@index([author_id], map: "forum_comments_author_id_fkey")
  @@index([parent_id], map: "forum_comments_parent_id_fkey")
  @@index([post_id], map: "forum_comments_post_id_fkey")
  @@map("forum_comments")
}

model ForumTag {
  id                  String                 @id @db.VarChar(40)
  name                String                 @unique @db.VarChar(60)
  slug                String                 @unique @db.VarChar(60)
  description         String?                @db.Text
  color               String?                @db.VarChar(20)
  usage_count         Int                    @default(0)
  created_at          DateTime               @default(now())
  community_relations ForumCommunityTag[]
  post_relations      ForumPostTagRelation[]

  @@index([slug])
  @@index([usage_count])
  @@map("forum_tags")
}

model ForumPostTagRelation {
  post_id String    @db.VarChar(40)
  tag_id  String    @db.VarChar(40)
  post    ForumPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag     ForumTag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([post_id, tag_id])
  @@index([tag_id])
  @@map("forum_post_tag_relations")
}

model ForumCommunityTag {
  community_id String         @db.VarChar(40)
  tag_id       String         @db.VarChar(40)
  is_featured  Boolean        @default(false)
  community    ForumCommunity @relation(fields: [community_id], references: [id], onDelete: Cascade)
  tag          ForumTag       @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([community_id, tag_id])
  @@index([tag_id], map: "forum_community_tags_tag_id_fkey")
  @@map("forum_community_tags")
}

model ForumCommunityRule {
  id           String         @id @db.VarChar(40)
  community_id String         @db.VarChar(40)
  title        String         @db.VarChar(120)
  body         String         @db.Text
  sort_order   Int            @default(0)
  created_at   DateTime       @default(now())
  community    ForumCommunity @relation(fields: [community_id], references: [id], onDelete: Cascade)

  @@index([community_id, sort_order])
  @@map("forum_community_rules")
}

model ForumCommunityLink {
  id           String         @id @db.VarChar(40)
  community_id String         @db.VarChar(40)
  label        String         @db.VarChar(120)
  url          String         @db.VarChar(255)
  description  String?        @db.Text
  sort_order   Int            @default(0)
  community    ForumCommunity @relation(fields: [community_id], references: [id], onDelete: Cascade)

  @@index([community_id, sort_order])
  @@map("forum_community_links")
}

model ForumCommunityMember {
  id           String         @id @db.VarChar(40)
  community_id String         @db.VarChar(40)
  user_id      String         @db.VarChar(40)
  role         MemberRole     @default(MEMBER)
  joined_at    DateTime       @default(now())
  community    ForumCommunity @relation(fields: [community_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@index([user_id])
  @@map("forum_community_members")
}

model ForumCommunityPermission {
  id           String         @id @db.VarChar(40)
  community_id String         @db.VarChar(40)
  role         MemberRole
  can_post     Boolean        @default(true)
  can_comment  Boolean        @default(true)
  can_moderate Boolean        @default(false)
  can_manage   Boolean        @default(false)
  community    ForumCommunity @relation(fields: [community_id], references: [id], onDelete: Cascade)

  @@unique([community_id, role])
  @@map("forum_community_permissions")
}

model ProblemList {
  id               String                       @id @db.VarChar(50)
  name             String                       @db.VarChar(120)
  description      String?                      @db.Text
  author_id        String                       @db.VarChar(40)
  is_public        Boolean                      @default(true)
  created_at       DateTime
  updated_at       DateTime
  is_featured      Boolean                      @default(false)
  banner_tag       String?                      @db.VarChar(30)
  banner_icon      String?                      @db.VarChar(50)
  banner_theme     String?                      @db.VarChar(30)
  banner_order     Int                          @default(0)
  problemRelations ProblemListProblemRelation[]

  @@map("problem_lists")
}

model ProblemListProblemRelation {
  list_id    String      @db.VarChar(50)
  problem_id BigInt
  sort_order Int         @default(0)
  added_at   DateTime    @default(now())
  list       ProblemList @relation(fields: [list_id], references: [id], onDelete: Cascade)
  problem    Problem     @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@id([list_id, problem_id])
  @@index([problem_id], map: "problem_list_problem_relations_problem_id_fkey")
  @@map("problem_list_problem_relations")
}

model BookmarkFolder {
  id          String     @id @default(uuid()) @db.VarChar(40)
  user_id     String     @db.VarChar(40)
  name        String     @db.VarChar(120)
  description String?    @db.Text
  icon        String?    @db.VarChar(50)
  color       String?    @db.VarChar(20)
  sort_order  Int        @default(0)
  is_default  Boolean    @default(false)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  bookmarks   Bookmark[]
  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, name])
  @@index([user_id])
  @@index([user_id, is_default])
  @@map("collections")
}

model Bookmark {
  id          String         @id @default(uuid()) @db.VarChar(40)
  folder_id   String         @map("collection_id") @db.VarChar(40)
  target_id   String         @db.VarChar(50)
  target_type BookmarkType   @map("target_type")
  sort_order  Int            @default(0)
  note        String?        @db.Text
  created_at  DateTime       @default(now())
  folder      BookmarkFolder @relation(fields: [folder_id], references: [id], onDelete: Cascade)

  @@unique([folder_id, target_type, target_id])
  @@index([target_type, target_id])
  @@map("collection_items")
}

model Solution {
  id         String            @id @db.VarChar(40)
  problem_id BigInt
  user_id    String            @db.VarChar(40)
  title      String            @db.VarChar(255)
  content    String            @db.Text
  summary    String?           @db.Text
  language   String            @db.VarChar(50)
  tags       Json?
  views        Int               @default(0)
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  is_published Boolean           @default(true)
  published_at DateTime?
  published_by String?           @db.VarChar(40)
  is_flagged   Boolean           @default(false)
  flagged_reason String?         @db.Text
  flagged_at   DateTime?
  is_deleted   Boolean           @default(false)
  deleted_at   DateTime?
  deleted_by   String?           @db.VarChar(40)
  comments     SolutionComment[]
  problem      Problem           @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([problem_id], map: "solutions_problem_id_fkey")
  @@index([user_id], map: "solutions_user_id_fkey")
  @@map("solutions")
}

model SolutionComment {
  id          String            @id @db.VarChar(40)
  solution_id String            @db.VarChar(40)
  parent_id   String?           @db.VarChar(40)
  user_id     String            @db.VarChar(40)
  content     String            @db.Text
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  parent      SolutionComment?  @relation("SolutionCommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies     SolutionComment[] @relation("SolutionCommentReplies")
  solution    Solution          @relation(fields: [solution_id], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  is_flagged     Boolean   @default(false)
  flagged_reason String?   @db.Text
  flagged_at     DateTime?
  is_deleted     Boolean   @default(false)
  deleted_at     DateTime?
  deleted_by     String?   @db.VarChar(40)

  @@index([parent_id], map: "solution_comments_parent_id_fkey")
  @@index([solution_id], map: "solution_comments_solution_id_fkey")
  @@index([user_id], map: "solution_comments_user_id_fkey")
  @@map("solution_comments")
}

model EdgeOperation {
  id             String                  @id @default(uuid()) @db.VarChar(40)
  target_id      String                  @db.VarChar(40)
  target_type    EdgeOperationTargetType
  operator_id    String                  @db.VarChar(40)
  operation_type EdgeOperationType
  created_at     DateTime                @default(now())
  operator       User                    @relation(fields: [operator_id], references: [id], onDelete: Cascade)

  @@unique([operator_id, operation_type, target_type, target_id], map: "edge_ops_unique")
  @@index([target_type, target_id], map: "edge_ops_target")
  @@index([operation_type, target_type, target_id], map: "edge_ops_operation_target")
  @@map("edge_operations")
}

model ProblemNote {
  id         String   @id @default(uuid()) @db.VarChar(40)
  problem_id BigInt
  user_id    String   @db.VarChar(40)
  content    String   @db.Text
  updated_at DateTime @updatedAt
  problem    Problem  @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, problem_id])
  @@index([problem_id], map: "problem_notes_problem_id_fkey")
  @@map("problem_notes")
}

model Submission {
  id                 String              @id @db.VarChar(40)
  problem_id         BigInt
  user_id            String              @db.VarChar(40)
  language           String              @db.VarChar(50)
  code               String              @db.Text
  status             String              @db.VarChar(40)
  runtime            Int
  memory             Float
  notes              String?             @db.Text
  created_at         DateTime            @default(now())
  runtime_percentile Float?
  memory_percentile  Float?
  test_details       Json?
  memoryDistBinsMb   Json?
  runtimeDistBinsMs  Json?
  contestSubmissions ContestSubmission[]
  problem            Problem             @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([problem_id, user_id])
  @@index([user_id], map: "submissions_user_id_fkey")
  @@map("submissions")
}

model SubmissionStatus {
  key         String   @id @db.VarChar(40)
  code        String   @db.VarChar(10)
  label       String   @db.VarChar(60)
  description String?  @db.Text
  suggestion  String?  @db.Text
  category    String   @db.VarChar(20)
  severity    String   @db.VarChar(20)
  is_terminal Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([category, severity])
  @@map("submission_statuses")
}

model View {
  id          String         @id @default(uuid()) @db.VarChar(40)
  target_id   String         @db.VarChar(40)
  target_type ViewTargetType
  user_id     String?        @db.VarChar(40)
  ip          String?        @db.VarChar(45)
  viewed_at   DateTime       @default(now())
  user        User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([target_type, target_id, user_id, ip])
  @@index([user_id], map: "views_user_id_fkey")
  @@map("views")
}

