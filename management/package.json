{
  "name": "admin-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "validate:i18n-keys": "node scripts/validate-i18n-keys.js",
    "check:i18n": "node --import jiti/register src/i18n/check.ts",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "test": "vitest --run --passWithNoTests --exclude '**/shared/theme/**'",
    "test:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest --coverage --passWithNoTests",
    "sync:theme-bootstrap": "node ../scripts/sync-theme-bootstrap.mjs",
    "verify:theme-sync": "node ../scripts/verify-theme-sync.mjs",
    "verify:typography-tokens": "node ../scripts/verify-typography-tokens.mjs"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/modifiers": "^9.0.0",
    "@internationalized/date": "^3.12.2",
    "@mdit/plugin-katex": "^0.25.2",
    "@tabler/icons-vue": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^8.21.3",
    "@types/markdown-it": "^14.1.2",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dnd-kit-vue": "^0.0.2",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "embla-carousel-vue": "^8.6.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "lucide-vue-next": "^0.562.0",
    "markdown-it": "^14.3.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.8",
    "vue-input-otp": "^0.3.2",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "~10.9.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "npm-run-all2": "^9.0.1",
    "prettier": "3.8.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.1"
  }
}
