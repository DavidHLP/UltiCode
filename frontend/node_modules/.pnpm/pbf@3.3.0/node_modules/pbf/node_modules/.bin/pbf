#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/david/UltiCode-Public/frontend/node_modules/.pnpm/pbf@3.3.0/node_modules/pbf/bin/node_modules:/home/david/UltiCode-Public/frontend/node_modules/.pnpm/pbf@3.3.0/node_modules/pbf/node_modules:/home/david/UltiCode-Public/frontend/node_modules/.pnpm/pbf@3.3.0/node_modules:/home/david/UltiCode-Public/frontend/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/david/UltiCode-Public/frontend/node_modules/.pnpm/pbf@3.3.0/node_modules/pbf/bin/node_modules:/home/david/UltiCode-Public/frontend/node_modules/.pnpm/pbf@3.3.0/node_modules/pbf/node_modules:/home/david/UltiCode-Public/frontend/node_modules/.pnpm/pbf@3.3.0/node_modules:/home/david/UltiCode-Public/frontend/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/pbf" "$@"
else
  exec node  "$basedir/../../bin/pbf" "$@"
fi
