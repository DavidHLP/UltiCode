{
  "name": "admin-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "validate:i18n-keys": "node scripts/validate-i18n-keys.js",
    "check:i18n": "node --import jiti/register src/i18n/check.ts",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "test": "vitest --run --passWithNoTests --exclude '**/packages/theme/**'",
    "test:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest --run --coverage",
    "sync:theme-bootstrap": "node ../../packages/theme/scripts/sync-theme-bootstrap.mjs",
    "verify:theme-sync": "node ../../packages/theme/scripts/verify-theme-sync.mjs",
    "verify:typography-tokens": "node ../../packages/theme/scripts/verify-typography-tokens.mjs"
  },
  "dependencies": {
    "@ulticode/app-bootstrap": "workspace:*",
    "@ulticode/auth-core": "workspace:*",
    "@ulticode/auth-ui": "workspace:*",
    "@ulticode/badge-config": "workspace:*",
    "@ulticode/datetime-utils": "workspace:*",
    "@ulticode/design-system": "workspace:*",
    "@ulticode/domain-types": "workspace:*",
    "@ulticode/http-client": "workspace:*",
    "@ulticode/i18n-completeness": "workspace:*",
    "@ulticode/locale-preference": "workspace:*",
    "@ulticode/markdown-utils": "workspace:*",
    "@ulticode/sidebar-menu": "workspace:*",
    "@ulticode/submission-status": "workspace:*",
    "@ulticode/theme": "workspace:*",
    "@dnd-kit/abstract": "^0.1.21",
    "@dnd-kit/dom": "^0.1.21",
    "@dnd-kit/modifiers": "^9.0.0",
    "@internationalized/date": "^3.12.4",
    "@mdit/plugin-katex": "^1.1.1",
    "@tabler/icons-vue": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^8.21.3",
    "@types/markdown-it": "^14.1.2",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dnd-kit-vue": "^0.0.2",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "embla-carousel-vue": "^8.6.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.3.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.0",
    "vue-i18n": "^11.4.12",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.0",
    "knip": "^6.36.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
