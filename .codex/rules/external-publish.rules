# Guard destructive external operations; authorized publication needs no extra prompt.

for wrapper in [[], ["rtk"], ["rtk", "proxy"]]:
    prefix_rule(
        pattern = wrapper + ["gh","repo","delete"],
        decision = "prompt",
        justification = "Repository deletion requires explicit authorization naming the target repository.",
        match = [" ".join(wrapper + ["gh","repo","delete","owner/repo"])],
        not_match = [" ".join(wrapper + ["gh","repo","view","owner/repo"])],
    )
    prefix_rule(
        pattern = wrapper + ["kubectl","delete"],
        decision = "prompt",
        justification = "Resource deletion can remove workloads or storage; confirm the cluster and target.",
        match = [" ".join(wrapper + ["kubectl","delete","-f","deployment.yaml"])],
        not_match = [" ".join(wrapper + ["kubectl","apply","-f","deployment.yaml"])],
    )
