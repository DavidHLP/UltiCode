{
  "name": "edit-markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run lint && pnpm run type-check && pnpm run format && pnpm run test && vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "validate:mocks": "node scripts/validate-mock-data.mjs",
    "validate:mocks:verbose": "node scripts/validate-mock-data.mjs --verbose",
    "validate:mocks:strict": "node scripts/validate-mock-data.mjs --strict"
  },
  "dependencies": {
    "@internationalized/date": "^3.10.0",
    "@monaco-editor/loader": "^1.7.0",
    "@stomp/stompjs": "^7.3.0",
    "@tabler/icons-vue": "^3.36.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/vue-virtual": "^3.13.18",
    "@unovis/ts": "^1.6.2",
    "@unovis/vue": "^1.6.2",
    "@vue-dnd-kit/core": "^1.7.0",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "katex": "^0.16.25",
    "lucide-vue-next": "^0.552.0",
    "markdown-it": "^14.1.0",
    "markdown-it-katex": "^2.0.3",
    "monaco-editor": "^0.52.2",
    "pinia": "^3.0.4",
    "reka-ui": "^2.6.1",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.25",
    "vue-i18n": "^10.0.0",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.82",
    "@iconify-json/radix-icons": "^1.2.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/node22": "^22.0.5",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.1",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.2.0",
    "knip": "^6.3.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "unplugin-icons": "^22.5.0",
    "vite": "^7.2.6",
