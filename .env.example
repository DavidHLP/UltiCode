# ============================================================
# UltiCode 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================================

# ============================================================
# 数据库配置 (Database Configuration)
# ============================================================
# 应用数据库连接 URL (用于 backend-spring)
# 格式: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# 注意: URL 中的特殊字符需要 URL 编码 (如 % 编码为 %25)
DATABASE_URL="mysql://ulticode:ulticode@localhost:23306/ulticode"

# 应用数据库连接参数 (用于 backend-spring)
DB_HOST=localhost
DB_PORT=23306
DB_USER=ulticode
DB_PASSWORD=ulticode
DB_NAME=ulticode

# Docker MySQL Root 密码 (用于 docker-compose)
MYSQL_ROOT_PASSWORD=root

# ============================================================
# 认证配置 (Authentication)
# ============================================================
# JWT 密钥用于签名访问令牌(15分钟有效期)和刷新令牌(7天有效期)
# 必须至少 32 个字符以保证加密安全性
# 生产环境请使用安全的随机字符串
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# JWT Cookie Secure 标志
# 开发环境 (HTTP): 设置为 false
# 生产环境 (HTTPS): 设置为 true
# 当 secure=true 时，cookie 只会通过 HTTPS 连接发送
JWT_COOKIE_SECURE=false

# ============================================================
# CORS 配置 (Cross-Origin Resource Sharing)
# ============================================================
# 允许的跨域请求来源，多个来源用逗号分隔
# 开发环境默认: http://localhost:9002,http://localhost:9003
# 生产环境必须设置为实际域名
CORS_ALLOWED_ORIGINS=http://localhost:9002,http://localhost:9003

# ============================================================
# Redis 配置
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_PASSWORD=

# ============================================================
# Docker/Judge 容器配置
# ============================================================
# 是否启用代码评测容器
JUDGE_CONTAINER_ENABLED=true
JUDGE_CONTAINER_IMAGE=ulticode-judge:latest
JUDGE_CONTAINER_POOL_SIZE=5
JUDGE_CONTAINER_MAX_CONTAINERS=10
JUDGE_DEFAULT_TIME_LIMIT=2000
JUDGE_DEFAULT_MEMORY_LIMIT=256
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ============================================================
# Nacos 服务发现配置
# ============================================================
NACOS_SERVER_ADDR=localhost:28848
NACOS_HOST=localhost
NACOS_PORT=28848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# ============================================================
# 推荐服务配置 (Recommendation Service)
# ============================================================
RECOMMENDATION_ENABLED=true
RECOMMENDATION_SERVICE_NAME=recommend-web
RECOMMENDATION_TIMEOUT=5000
RECOMMENDATION_FALLBACK_URL=http://localhost:28081

# ============================================================
# OAuth 配置 (可选)
# ============================================================
# GitHub OAuth - 从 https://github.com/settings/developers 获取
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:9001/auth/github/callback

# Google OAuth - 从 Google Cloud Console 获取
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:9001/auth/google/callback

# ============================================================
# 支付配置 (Stripe - 可选)
# ============================================================
# 从 https://dashboard.stripe.com/apikeys 获取
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRICE_PREMIUM_MONTHLY="price_your_monthly_price_id"
STRIPE_PRICE_PREMIUM_YEARLY="price_yearly_price_id"

# ============================================================
# 邮件配置 (Email - 可选)
# ============================================================
# 用于密码重置等功能
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_ENABLED=false

# ============================================================
# 前端配置 (Frontend)
# ============================================================
# Vite 会自动读取 VITE_ 前缀的环境变量
VITE_API_BASE_URL=http://localhost:9001
VITE_TEST_USERNAME=
VITE_TEST_PASSWORD=
