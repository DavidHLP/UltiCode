# ====================================================================
# 1. 编译产物与构建目录 (Compiled Output)
# ====================================================================
/dist/
/build/
/target/
/bin/
/out/
node_modules/
**/node_modules/
/backend/
/console/node_modules/
/management/node_modules/
/shared/node_modules/
.gradle/
*.class
*.jar
!tools/arthas-boot.jar
*.war
*.ear

# ====================================================================
# 2. 语言特定规则 (Language Specific)
# ====================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
# Flyway CLI (auto-downloaded by setup.sh)
db-manager/flyway/
.pytest_cache/
.mypy_cache/
.tox/
*.egg-info/
.python-version

# --- Java / Spring Boot ---
.help.md
/logs/
*.log.gz
/db/
# 忽略 Maven 生成的单元测试报告
**/target/surefire-reports/
# init-db 的构建产物 (Maven 本地仓库缓存)
init-db/target/
init-db/project-local-repo/

# --- Vue 3 / Frontend ---
dist-ssr/
*.local
.eslintcache
.stylelintcache
.vite-inspect
# vue-tsc incremental build cache (replaces the stale `.tsbuildinfo`
# pattern that only matched the flat-package layout; vue-tsc 2.x writes
# `*.tsbuildinfo` next to each tsconfig.json).
*.tsbuildinfo
**/tsconfig.tsbuildinfo
**/tsconfig.*.tsbuildinfo
# 环境变量文件（含敏感信息，禁止进入 Git）
.env
.env.*
!.env.example
!.env.test.example

# ====================================================================
# 3. 日志与调试 (Logs & Debug)
# ====================================================================
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ====================================================================
# 4. 操作系统与临时文件 (OS & Temp)
# ====================================================================
.DS_Store
Thumbs.db
.temp
.tmp
.worktrees/
worktrees/
pids
*.pid
*.seed
*.pid.lock

# Node.js 诊断报告
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ====================================================================
# 5. IDE 与 编辑器 (IDEs and Editors)
# ====================================================================

# --- General ---
.idea/
*.iws
*.iml
*.ipr
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.nb-configuration.xml

# --- VSCode ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- AI Tools ---
.claude/PRPs/
.claude/memory/
.claude/reviews/
# codebase-memory-mcp local code graph index cache (regeneratable, ties to HEAD)
.codebase-memory/
# .claude/settings.json is COMMITTED (team-shared statusLine config).
# .claude/settings.local.json holds per-user MCP / hooks / permissions and is
# covered by the user-global gitignore, but we mirror the rule here for teams
# where the global ignore isn't installed.
.claude/settings.local.json
.claude/.arthas/
.zcode/
# ====================================================================
# 6. 测试与覆盖率 (Tests & Coverage)
# ====================================================================
/coverage
/.nyc_output
htmlcov/
.noserc
.fluentd.conf

.playwright-mcp

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json
.antigravitycli
.vscode


# Phase 2 D-form harness pre-compile staging dir (regenerated by harness/build.sh)
docker/sandbox/harness-staging/

# OhMyOpenCode local plans / state
.omo/

# Local JDK toolchain managers (vfox / asdf / sdkman) — per-developer state, not project config.
# Project Java version is governed by AGENTS.md / backend-spring pom.xml <java.version>.
.vfox/
.vfox.toml
.tool-versions
