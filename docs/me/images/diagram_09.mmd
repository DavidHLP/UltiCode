graph TD
    subgraph Controller[Controller Layer]
        AuthC[Auth]
        UserC[User]
        ProbC[Prob]
        SubmC[Subm]
        ContC[Cont]
        ForumC[Forum]
        SolC[Sol]
    end

    subgraph Service[Service Layer]
        AuthS[AuthSvc]
        UserS[UserSvc]
        ProbS[ProbSvc]
        SubmS[SubmSvc]
        ContS[ContSvc]
        ForumS[ForumSvc]
        SolS[SolSvc]
    end

    subgraph Infra[Infrastructure Layer]
        MySQL[(MySQL 主从)]
        Redis[(Redis 缓存)]
        Dubbo[Dubbo RPC]
        Spark[Spark 离线]
        Nacos[Nacos 注册]
    end

    Controller --> Service
    Service --> Infra

    AuthC --> AuthS
    UserC --> UserS
    ProbC --> ProbS
    SubmC --> SubmS
    ContC --> ContS
    ForumC --> ForumS
    SolC --> SolS

    AuthS --> MySQL
    UserS --> MySQL
    SubmS --> Redis
    SubmS --> MySQL
    ContS --> Redis