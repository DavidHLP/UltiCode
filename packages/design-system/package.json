{
  "name": "@ulticode/design-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./style.css": "./style.css",
    "./palette": {
      "import": "./src/palette.ts",
      "types": "./src/palette.ts"
    },
    "./utils/cn": {
      "import": "./src/utils/cn.ts",
      "types": "./src/utils/cn.ts"
    },
    "./ui/*": {
      "types": "./src/components/ui/*/index.ts",
      "import": "./src/components/ui/*/index.ts"
    },
    "./ui-files/*": "./src/components/ui/*",
    "./DetailPanel.vue": "./src/components/DetailPanel.vue",
    "./DetailField.vue": "./src/components/DetailField.vue",
    "./StatusBadge.vue": "./src/components/StatusBadge.vue",
    "./AppearanceSettings.vue": "./src/components/appearance/AppearanceSettings.vue"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "type-check": "vue-tsc --build"
  },
  "peerDependencies": {
    "reka-ui": "^2.9.0",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@internationalized/date": "^3.11.0",
    "@lucide/vue": "1.52.0",
    "@ulticode/theme": "workspace:*",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.0",
    "shadcn-vue": "2.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
