{
  "name": "edit-markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "test": "vitest --run --passWithNoTests --exclude '**/auth-core/**' --exclude '**/packages/theme/**'",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "check:i18n": "node --import jiti/register src/i18n/check.ts",
    "validate:i18n-keys": "node --import jiti/register src/i18n/check.ts --json",
    "validate:mocks": "node scripts/validate-mock-data.mjs",
    "validate:mocks:verbose": "node scripts/validate-mock-data.mjs --verbose",
    "validate:mocks:strict": "node scripts/validate-mock-data.mjs --strict",
    "sync:theme-bootstrap": "node ../../packages/theme/scripts/sync-theme-bootstrap.mjs",
    "verify:theme-sync": "node ../../packages/theme/scripts/verify-theme-sync.mjs",
    "verify:typography-tokens": "node ../../packages/theme/scripts/verify-typography-tokens.mjs"
  },
  "dependencies": {
    "@ulticode/app-bootstrap": "workspace:*",
    "@ulticode/auth-core": "workspace:*",
    "@ulticode/auth-ui": "workspace:*",
    "@ulticode/badge-config": "workspace:*",
    "@ulticode/datetime-utils": "workspace:*",
    "@ulticode/design-system": "workspace:*",
    "@ulticode/domain-types": "workspace:*",
    "@ulticode/http-client": "workspace:*",
    "@ulticode/i18n-completeness": "workspace:*",
    "@ulticode/locale-preference": "workspace:*",
    "@ulticode/markdown-utils": "workspace:*",
    "@ulticode/sidebar-menu": "workspace:*",
    "@ulticode/submission-status": "workspace:*",
    "@ulticode/theme": "workspace:*",
    "@internationalized/date": "^3.12.4",
    "@mdit/plugin-katex": "^0.25.2",
    "@monaco-editor/loader": "^1.7.0",
    "@stomp/stompjs": "^7.3.0",
    "@tabler/icons-vue": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-virtual": "^3.13.39",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vue-dnd-kit/core": "1.7.0",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.3",
    "katex": "^0.18.7",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.3.2",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.133",
    "@iconify-json/radix-icons": "^1.2.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/node22": "^22.0.6",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.1",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.36.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.7",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
