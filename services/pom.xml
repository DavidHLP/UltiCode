<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version>
		<relativePath/>
	</parent>
	<groupId>com.ulticode</groupId>
	<artifactId>ulticode-backend</artifactId>
	<!-- CI-friendly reactor revision; each deployable service additionally carries its
	     own release version (service.version.*) so images can be tagged and released
	     per service instead of reactor-wide 1.0.0. flatten-maven-plugin resolves
	     these properties into literal versions for install/deploy. -->
	<version>${revision}</version>
	<name>UltiCode Backend</name>
	<description>UltiCode Online Programming Platform - Spring Boot Backend (reactor)</description>
	<packaging>pom</packaging>

	<modules>
		<module>platform/common</module>
		<module>platform/rpc-resilience</module>
		<module>platform/web-security</module>
		<module>platform/integration-inbox</module>
		<module>platform/judge-config</module>
		<module>api/auth-api</module>
		<module>api/submission-api</module>
		<module>api/notification-api</module>
		<module>api/app-api</module>
		<module>judge-runtime</module>
		<module>auth</module>
		<module>admin</module>
		<module>search</module>
		<module>app</module>
		<module>submission</module>
		<module>notification</module>
		<module>judge</module>
	</modules>

	<properties>
		<revision>1.0.0</revision>
		<!-- Per-service release versions: bump individually to release one owner
		     service (its image tag) independently of the shared platform modules.
		     Consumed by docker-publish.yml to add a v<version> GHCR tag. -->
		<service.version.auth>1.0.0</service.version.auth>
		<service.version.admin>1.0.0</service.version.admin>
		<service.version.app>1.0.0</service.version.app>
		<service.version.submission>1.0.0</service.version.submission>
		<service.version.search>1.0.0</service.version.search>
		<service.version.notification>1.0.0</service.version.notification>
		<service.version.judge>1.0.0</service.version.judge>
		<java.version>17</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<mybatis-plus.version>3.5.16</mybatis-plus.version>
		<jjwt.version>0.13.0</jjwt.version>
		<redisson.version>4.3.1</redisson.version>
		<springdoc.version>2.6.0</springdoc.version>
		<dubbo.version>3.3.6</dubbo.version>
		<hutool.version>5.8.44</hutool.version>
		<lombok.version>1.18.46</lombok.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<japicmp.version>0.26.1</japicmp.version>
		<coverage.bundle.minimum>0.50</coverage.bundle.minimum>
		<!-- Submission has an explicit owner-specific floor because its current
		     source-inclusive baseline is lower than the shared service floor. -->
		<coverage.bundle.submission.minimum>0.25</coverage.bundle.submission.minimum>
		<coverage.security.minimum>0.25</coverage.security.minimum>
		<coverage.idempotency.minimum>0.50</coverage.idempotency.minimum>
		<!-- Contract compat gate: old artifact to compare against.
							A baseline version is required explicitly; the sentinel below is
							rejected by the contract-compat profile instead of allowing a
							self-comparison.
		     CI resolves this from the baseline tag's installed artifacts; see
		     services/docs/CONTRACT_COMPAT_GATE.md. -->
		<contract.compat.oldVersion>__missing_contract_baseline__</contract.compat.oldVersion>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-common</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-rpc-resilience</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-auth-api</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-app-api</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-submission-api</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-notification-api</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-submission-domain</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-judge-runtime</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-submission</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-moderation-domain</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-contest-domain</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-problem-domain</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-auth</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-admin</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-app</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-web-security</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-integration-inbox</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-judge-config</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>1.21.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!--
			  P1-INFRA-003: NO dubbo-bom import on purpose. The `dubbo-bom`
			  3.3.6 is a mega-BOM that re-pins Spring Framework, Spring
			  Security, javax.servlet-api, and ~80 other artifacts to the
			  Spring Boot 2.x line (spring-test 5.3.39 etc.), which silently
			  overrides the parent pom's spring-boot-dependencies-bom 3.2.5
			  and breaks every jakarta.servlet API bit (e.g. existing
			  OAuthStateModuleTest compiles MockHttpServletResponse from
			  Spring 5.3 → javax.servlet, but the production code uses
			  jakarta.servlet). Backend-legacy declares its two Dubbo
			  dependencies with explicit <version>${dubbo.version}</version>
			  so the BOM is unnecessary.
			-->
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok-mapstruct-binding</artifactId>
								<version>0.2.0</version>
							</path>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${mapstruct.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
				<!--
				  Mockito 5 + ByteBuddy need -Djdk.attach.allowAttachSelf
				  to self-attach under Oracle JDK 17.0.2 (which is what
				  `mvn test` picks up in the main worktree). Without
				  this, every @Mock / @Spy test errors with
				  "Could not initialize inline Byte Buddy mock maker".
				  @{argLine} preserves the jacoco -javaagent:... argLine
				  that the jacoco-maven-plugin injects at the prepare-agent
					  phase; we just append the attach flag.
				-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>@{argLine} -Djdk.attach.allowAttachSelf=true</argLine>
						<failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!--
			  Per-service independent versioning: resolve ${revision} and the
			  per-service ${service.version.*} references into literal versions in
			  the installed/deployed POMs while keeping reactor resolution intact.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.6.0</version>
				<configuration>
					<updatePomFile>true</updatePomFile>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>contract-compat</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<id>require-contract-baseline</id>
								<phase>validate</phase>
								<goals><goal>enforce</goal></goals>
								<configuration>
									<rules>
										<requireProperty>
											<property>contract.compat.oldVersion</property>
											<message>Contract compatibility requires an explicit baseline revision</message>
											<regex>^(?!__missing_contract_baseline__$).+$</regex>
											<regexMessage>contract.compat.oldVersion must not use the missing-baseline sentinel</regexMessage>
										</requireProperty>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>com.github.siom79.japicmp</groupId>
						<artifactId>japicmp-maven-plugin</artifactId>
						<version>${japicmp.version}</version>
						<configuration>
							<oldVersion>
								<dependency>
									<groupId>${project.groupId}</groupId>
									<artifactId>${project.artifactId}</artifactId>
									<version>${contract.compat.oldVersion}</version>
									<type>jar</type>
								</dependency>
							</oldVersion>
							<newVersion>
								<file>
									<path>${project.build.directory}/${project.artifactId}-${project.version}.${project.packaging}</path>
								</file>
							</newVersion>
							<parameter>
								<onlyModified>true</onlyModified>
								<accessModifier>public</accessModifier>
								<breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
								<includeSynthetic>false</includeSynthetic>
								<onlyBinaryIncompatible>false</onlyBinaryIncompatible>
								<ignoreMissingClasses>false</ignoreMissingClasses>
								<skipPomModules>true</skipPomModules>
								<packagingSupporteds>
									<packagingSupported>jar</packagingSupported>
								</packagingSupporteds>
								<includeModules>
									<includeModule>backend-.*-api</includeModule>
								</includeModules>
							</parameter>
						</configuration>
						<executions>
							<execution>
								<id>contract-compat-check</id>
								<phase>verify</phase>
								<goals>
									<goal>cmp</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
