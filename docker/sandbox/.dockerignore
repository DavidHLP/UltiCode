# Generic artifacts — NEVER pull these into the build context.
target/
__pycache__/
*.pyc
*.class
.git/
node_modules/
.gradle/
build/
dist/
out/

# Re-include the pre-compiled harness staging dir. The generic `*.class`
# and `*.pyc` rules above would otherwise drop the Java .class files and
# Python .pyc files that the Dockerfile explicitly COPYs from harness-staging/.
# Dockerfile context requires these so the runtime image has a populated
# /opt/harness/ tree.
#
# Order matters: .dockerignore applies rules bottom-up, so the negation
# below wins over the patterns above.
!harness-staging/
!harness-staging/**
!harness-staging/java/**
!harness-staging/python/**
!harness-staging/c/**
!harness-staging/cpp/**
