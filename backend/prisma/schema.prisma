// ============================================================================
// I18N - Translation Table
// ============================================================================

model Translation {
  id          String   @id @default(uuid()) @db.VarChar(40)
  entity_type String   @db.VarChar(50) // PROBLEM, PROBLEM_DETAIL, CONTEST, SUBMISSION_STATUS, etc.
  entity_id   String   @db.VarChar(50) // Reference to original entity ID
  field_name  String   @db.VarChar(50) // title, summary, description, etc.
  locale      String   @db.VarChar(10) // en-US, zh-CN
  content     String   @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([entity_type, entity_id, field_name, locale])
  @@index([entity_type, entity_id, locale])
  @@index([locale])
  @@map("translations")
}

// ============================================================================
// Admin - Permission & Audit System
// ============================================================================

model PasswordReset {
  id         String   @id @default(uuid()) @db.VarChar(40)
  user_id    String   @db.VarChar(40)
  token      String   @unique @db.VarChar(255)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime @default(now())

  @@index([token])
  @@index([user_id])
  @@index([expires_at])
  @@map("password_resets")
}

model UserPermission {
  id          String             @id @default(uuid()) @db.VarChar(40)
  user_id     String             @db.VarChar(40)
  action      PermissionAction
  resource    PermissionResource
  granted_by  String             @db.VarChar(40)
  granted_at  DateTime           @default(now())
  expires_at  DateTime?
  user        User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, action, resource])
  @@index([user_id])
  @@map("user_permissions")
}

model RolePermission {
  id          String             @id @default(uuid()) @db.VarChar(40)
  role        UserRole
  action      PermissionAction
  resource    PermissionResource
  created_at  DateTime           @default(now())

  @@unique([role, action, resource])
  @@index([role])
  @@map("role_permissions")
}

model AuditLog {
  id            String          @id @default(uuid()) @db.VarChar(40)
  performer_id  String          @db.VarChar(40)
  user_id       String?         @db.VarChar(40)
  action        String          @db.VarChar(100)
  entity_type   String          @db.VarChar(50)
  entity_id     String          @db.VarChar(50)
  old_values    Json?
  new_values    Json?
  ip_address    String?         @db.VarChar(45)
  user_agent    String?         @db.VarChar(255)
  created_at    DateTime        @default(now())

  performer     User            @relation("AuditLogPerformer", fields: [performer_id], references: [id])
  user          User?           @relation("AuditLogUser", fields: [user_id], references: [id])

  @@index([performer_id])
  @@index([user_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id @db.VarChar(50)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updated_at  DateTime @updatedAt

  @@map("system_settings")
}
