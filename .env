# ============================================================
# UltiCode 统一环境变量配置
# ============================================================
# 此文件整合了所有模块的环境变量配置
# 各模块（backend-spring、console、management）均从此读取配置
# ============================================================

# ============================================================
# 数据库配置 (Database Configuration)
# ============================================================
# 应用数据库连接 (用于 backend-spring)
DATABASE_URL="mysql://ulticode:2%5BOGT%23ds%3E1h7xZM%3CO%5D7%3B2%5BF%26@localhost:23306/ulticode"
DB_HOST=localhost
DB_PORT=23306
DB_USER=ulticode
DB_PASSWORD=ulticode
DB_NAME=ulticode

# Docker MySQL Root 密码
MYSQL_ROOT_PASSWORD=aOaeLLpLtYE0O0j0yA80lC6CTUoySQmJ

# ============================================================
# 认证配置 (Authentication)
# ============================================================
JWT_SECRET="5GXMfun06YtfZSSV5h3M7yNA9fmuagbY5dITQyqSVDfcgebV-DqD9upy0zsSpPbKVKdRh4kllefbUFaTDuvpSA"
# JWT Cookie Secure flag (false for HTTP development, true for HTTPS production)
JWT_COOKIE_SECURE=false

# ============================================================
# Redis 配置
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_PASSWORD=

# ============================================================
# Docker/Judge 容器配置
# ============================================================
JUDGE_CONTAINER_ENABLED=true
JUDGE_CONTAINER_IMAGE=ulticode-judge:latest
JUDGE_CONTAINER_POOL_SIZE=5
JUDGE_CONTAINER_MAX_CONTAINERS=10
JUDGE_DEFAULT_TIME_LIMIT=2000
JUDGE_DEFAULT_MEMORY_LIMIT=256
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ============================================================
# Nacos 服务发现配置
# ============================================================
NACOS_SERVER_ADDR=localhost:28848
NACOS_HOST=localhost
NACOS_PORT=28848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# ============================================================
# 推荐服务配置 (Recommendation Service)
# ============================================================
RECOMMENDATION_ENABLED=true
RECOMMENDATION_SERVICE_NAME=recommend-web
RECOMMENDATION_TIMEOUT=5000
RECOMMENDATION_FALLBACK_URL=http://localhost:28081

# ============================================================
# OAuth 配置 (可选)
# ============================================================
# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:9001/auth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:9001/auth/google/callback

# ============================================================
# 支付配置 (Stripe - 可选)
# ============================================================
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_PREMIUM_MONTHLY="price_xxx"
STRIPE_PRICE_PREMIUM_YEARLY="price_xxx"

# ============================================================
# 邮件配置 (Email - 可选)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_ENABLED=false

# ============================================================
# 前端配置 (Frontend - Vite 自动读取 VITE_ 前缀)
# ============================================================
VITE_API_BASE_URL=http://localhost:9001
VITE_TEST_USERNAME=
VITE_TEST_PASSWORD=
