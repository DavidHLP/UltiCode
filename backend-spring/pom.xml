<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version>
		<relativePath/>
	</parent>
	<groupId>com.ulticode</groupId>
	<artifactId>ulticode-backend</artifactId>
	<version>1.0.0</version>
	<name>UltiCode Backend</name>
	<description>UltiCode Online Programming Platform - Spring Boot Backend (reactor)</description>
	<packaging>pom</packaging>

	<modules>
		<module>backend-common</module>
		<module>backend-api</module>
		<module>backend-auth</module>
		<module>backend-admin</module>
		<module>backend-app</module>
		<module>backend-legacy</module>
	</modules>

	<properties>
		<java.version>17</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<mybatis-plus.version>3.5.16</mybatis-plus.version>
		<jjwt.version>0.13.0</jjwt.version>
		<redisson.version>4.3.1</redisson.version>
		<springdoc.version>2.6.0</springdoc.version>
		<dubbo.version>3.3.6</dubbo.version>
		<hutool.version>5.8.44</hutool.version>
		<lombok.version>1.18.46</lombok.version>
		<mapstruct.version>1.6.3</mapstruct.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-auth-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-app-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-auth</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-admin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-app</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.ulticode</groupId>
				<artifactId>backend-legacy</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>1.21.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok-mapstruct-binding</artifactId>
								<version>0.2.0</version>
							</path>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${mapstruct.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
				<!--
				  Mockito 5 + ByteBuddy need -Djdk.attach.allowAttachSelf
				  to self-attach under Oracle JDK 17.0.2 (which is what
				  `mvn test` picks up in the main worktree). Without
				  this, every @Mock / @Spy test errors with
				  "Could not initialize inline Byte Buddy mock maker".
				  @{argLine} preserves the jacoco -javaagent:... argLine
				  that the jacoco-maven-plugin injects at the prepare-agent
					  phase; we just append the attach flag.
				-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>@{argLine} -Djdk.attach.allowAttachSelf=true</argLine>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>