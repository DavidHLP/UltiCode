# UltiCode local development environment
#
# Do not copy this file and reuse the placeholders. Generate a private `.env`
# containing random infrastructure credentials and documented local app users:
#
#   ./scripts/dev/init-env.sh
#
# `up.sh --prepare-submission-owner` first starts infrastructure, runs the
# deterministic five-Owner migration manifest and unlocks the owners without
# starting PM2:
#
#   ./scripts/dev/up.sh --prepare-submission-owner
#
# Then run the confirmation-gated cutover/grant observation from the migration
# guide, set SUBMISSION_CUTOVER_COMPLETE=true, and start the complete stack:
#
#   ./scripts/dev/up.sh

# Runtime
SPRING_PROFILES_ACTIVE=dev
# Direct backend-app fallback; PM2/Compose override each owner to 9101/9102/9103.
SERVER_PORT=9103
CONSOLE_PORT=9002
MANAGEMENT_PORT=9003

# Migration bootstrap only. Runtime services use explicit Owner variables below.
DB_HOST=localhost
DB_PORT=23306
DB_USER=ulticode
DB_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
DB_NAME=ulticode
# Owner runtime schemas/accounts. Owners may share this MySQL instance, but
# each runtime account is scoped to its own schema.
AUTH_DB_HOST=localhost
AUTH_DB_PORT=23306
AUTH_DB_NAME=auth
AUTH_DB_USER=auth_rw
AUTH_DB_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=23306
ADMIN_DB_NAME=admin
ADMIN_DB_USER=admin_rw
ADMIN_DB_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
APP_DB_HOST=localhost
APP_DB_PORT=23306
APP_DB_NAME=app
APP_DB_USER=app_rw
APP_DB_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=23306
NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_USER=notification_rw
NOTIFICATION_DB_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh

# Submission owner runtime.
SUBMISSION_DB_HOST=localhost
SUBMISSION_DB_PORT=23306
SUBMISSION_DB_NAME=submission
SUBMISSION_DB_USER=submission_rw
SUBMISSION_DB_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
# Separate privileged identity for Submission owner migrations.
SUBMISSION_MIGRATION_DB_USER=migration_submission
SUBMISSION_MIGRATION_DB_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
APP_SUBMISSION_ROUTING_MODE=remote
# One-time cutover input (do not persist in `.env`):
# `SUBMISSION_CUTOVER_QUIESCE_CONFIRM=I_UNDERSTAND_SUBMISSION_QUIESCE_ALL_WRITERS`
SUBMISSION_CUTOVER_COMPLETE=false
SUBMISSION_APP_DB_USER=app_rw
SUBMISSION_APP_DB_HOST=%
NOTIFICATION_APP_DB_USER=
MYSQL_ROOT_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
DB_ROOT_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
# Explicit privileged owner migration job input. Required when
# MIGRATION_SCHEMA is auth/admin/app/notification/submission; never reuse a
# runtime *_DB_USER as the migration account.
MIGRATION_DB_HOST=
MIGRATION_DB_PORT=
MIGRATION_DB_NAME=
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
# DEV-LOCAL only: when the host lacks mysql CLI, run preflight through an
# explicit local MySQL container; Flyway still uses the explicit MIGRATION_DB_*.
MIGRATION_MYSQL_CONTAINER=
MIGRATION_MYSQL_CONTAINER_PORT=3306
# Explicit DEV-LOCAL-only baseline adoption requires this flag plus the
# one-time DEV_LOCAL_OWNER_BASELINE_CONFIRM token.
DEV_LOCAL_OWNER_BASELINE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_DB=0
REDIS_ACL_DIR=.local/redis
# Per-owner Redis ACL credentials (review 2026-08-25). The shared
# REDIS_PASSWORD is gone: each security domain authenticates as its own ACL
# user in the runtime REDIS_ACL_DIR (default `.local/redis`; default user
# disabled). The values below are DEV-ONLY placeholders; init-env.sh generates
# the runtime ACL outside Git. Production must rotate all of them with
# scripts/runbooks/redis-acl-rotation.sh.
AUTH_REDIS_PASSWORD=dev-only-auth-redis-password
ADMIN_REDIS_PASSWORD=dev-only-admin-redis-password
APP_REDIS_PASSWORD=dev-only-app-redis-password
SUBMISSION_REDIS_PASSWORD=dev-only-submission-redis-password
SEARCH_REDIS_PASSWORD=dev-only-search-redis-password
NOTIFICATION_REDIS_PASSWORD=dev-only-notification-redis-password
JUDGE_REDIS_PASSWORD=dev-only-judge-redis-password
OPS_REDIS_PASSWORD=dev-only-ops-redis-password
HEALTH_REDIS_PASSWORD=dev-only-health-redis-password
REDIS_REPLICATION_PASSWORD=dev-only-redis-replication-password
REDIS_SENTINEL_PASSWORD=dev-only-redis-sentinel-password
# Production only: mount a secret-managed directory containing the certificate
# and private key; do not put PEM material in this repository.
# TLS_CERT_DIR=/run/secrets/ulticode-tls
# Production Dubbo Triple mTLS: one secret-managed subdirectory per workload
# (backend-auth/admin/app/submission/notification/judge). Each directory
# contains identity.crt, identity.key, trusted-callers.pem and
# trusted-services.pem. These are CA bundles; the provider filter separately
# enforces exact SPIFFE/DNS SAN identities and the delegation caller matrix.
# Rotate by overlapping old and new CA/certificate material before removal.
# DUBBO_MTLS_CERT_DIR=/run/secrets/ulticode-dubbo
# CONSOLE_HTTPS_PORT=9443
# MANAGEMENT_HTTPS_PORT=9444
# Running a single service locally against the dev stack? Export the matching
# pair, e.g. for auth:
#   REDIS_USERNAME=ulticode-auth REDIS_PASSWORD="$AUTH_REDIS_PASSWORD"

# JWT and browser security
JWT_SECRET=GENERATED_BY_scripts_dev_init_env_sh_minimum_32_chars
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:9002,http://localhost:9003,http://127.0.0.1:9002,http://127.0.0.1:9003
FRONTEND_URL=http://localhost:9002

# Nacos
NACOS_SERVER_ADDR=localhost:28848
NACOS_HOST=localhost
NACOS_PORT=28848
NACOS_GRPC_PORT=29848
NACOS_NAMESPACE=dev
NACOS_GROUP=DEFAULT_GROUP
DUBBO_NAMESPACE=dev
NACOS_USERNAME=ulticode_dev_admin
NACOS_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
# Dev-only per-service Nacos registry identities generated by init-env.sh.
AUTH_NACOS_USERNAME=ulticode-auth
AUTH_NACOS_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
ADMIN_NACOS_USERNAME=ulticode-admin
ADMIN_NACOS_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
APP_NACOS_USERNAME=ulticode-app
APP_NACOS_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
SUBMISSION_NACOS_USERNAME=ulticode-submission
SUBMISSION_NACOS_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
NOTIFICATION_NACOS_USERNAME=ulticode-notification
NOTIFICATION_NACOS_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
JUDGE_NACOS_USERNAME=ulticode-judge
JUDGE_NACOS_PASSWORD=GENERATED_BY_scripts_dev_init_env_sh
NACOS_AUTH_TOKEN=GENERATED_BY_scripts_dev_init_env_sh
NACOS_AUTH_IDENTITY_KEY=GENERATED_BY_scripts_dev_init_env_sh
NACOS_AUTH_IDENTITY_VALUE=GENERATED_BY_scripts_dev_init_env_sh
# Production-only trust controls; set these in the deployment secret store.
#NACOS_DB_USER=nacos_rw
#NACOS_DB_PASSWORD=GENERATED_IN_DEPLOYMENT_SECRET_STORE
#DUBBO_NAMESPACE=ulticode-prod
# Optional HA reference profile (never enabled by default). It requires an
# operator-managed REDIS_HA_CONFIG_DIR containing redis-replica.conf and three
# Sentinel configs; those files carry replication/Sentinel credentials and are
# never committed. Set NACOS_SERVERS to the real three-node peer list.
# Production HA also requires REDIS_REPLICATION_PASSWORD and
# REDIS_SENTINEL_PASSWORD; render users.acl after setting all secret values.
# HA_COMPOSE_ENV_FILE=/run/secrets/ulticode-ha.env
# REDIS_HA_CONFIG_DIR=/run/secrets/ulticode-redis-ha
# NACOS_SERVERS=nacos:8848 nacos-2:8848 nacos-3:8848
# HA_RECONNECT_DRILL=1
# Auth access-token signing (base64 PKCS8 private key; secret-store only).
#JWT_RSA_PRIVATE_KEY=BASE64_PKCS8_PRIVATE_KEY_FROM_SECRET_STORE
# Admin internal-delegation signing (base64 PKCS8 private keys; secret-store only).
#INTERNAL_DELEGATION_PRIVATE_KEY=BASE64_PKCS8_PRIVATE_KEY_FROM_SECRET_STORE
#BOOTSTRAP_DELEGATION_PRIVATE_KEY=BASE64_PKCS8_PRIVATE_KEY_FROM_SECRET_STORE
# Public X509 counterparts distributed to Auth/App/Notification.
#INTERNAL_DELEGATION_PUBLIC_KEY=BASE64_X509_PUBLIC_KEY_FROM_SECRET_STORE
#BOOTSTRAP_DELEGATION_PUBLIC_KEY=BASE64_X509_PUBLIC_KEY_FROM_SECRET_STORE
# Shared key identifiers are non-secret and must match each key pair.
#INTERNAL_DELEGATION_KEY_ID=ADMIN_DELEGATION_KEY_ID
#BOOTSTRAP_DELEGATION_KEY_ID=BOOTSTRAP_DELEGATION_KEY_ID

# Local features
SPRINGDOC_ENABLED=true
MEILISEARCH_ENABLED=false
# Production only: set this to an operator-managed OTLP/HTTP collector
# reachable from the deployment Compose network. When
# `MANAGEMENT_OTLP_AUTHORIZATION` is non-empty, the platform security guard
# requires this endpoint to use HTTPS. Deliberately left unset:
# docker-compose.prod.yml rejects an unset or empty value, so production
# Compose validation and deploys fail closed until an operator consciously
# sets a real endpoint.
#MANAGEMENT_OTLP_TRACING_ENDPOINT=https://otlp.example.invalid/v1/traces
#MANAGEMENT_OTLP_AUTHORIZATION=<secret-store; requires HTTPS endpoint>
# Optional S3-compatible/R2 object storage. Keep the bucket private and
# provide access/secret keys from the deployment secret store, never Git.
#APP_STORAGE_TYPE=s3
#APP_STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#APP_STORAGE_S3_BUCKET=<private-bucket>
#APP_STORAGE_S3_TLS_ENABLED=true
#APP_STORAGE_S3_ACCESS_KEY=<secret-store>
#APP_STORAGE_S3_SECRET_KEY=<secret-store>
# Optional managed OTLP overlay; use a deployment secret file for the
# authorization header and an HTTPS endpoint.
#MANAGED_OTLP_TRACING_ENDPOINT=https://otlp.example.invalid/v1/traces
# Optional managed OTLP sampling override (0.0 to 1.0).
#MANAGED_OTLP_SAMPLING_PROBABILITY=0.1
# The owner defaults remain 1.0 for local diagnostics.
#MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
#MANAGED_OTLP_AUTHORIZATION=<secret-store>
# Generated by init-env.sh; startup/test fall back to an in-memory disposable
# value for older env files and never persist it automatically.
MEILI_MASTER_KEY=GENERATED_BY_scripts_dev_init_env_sh
# Optional Judge0 async Adapter. Keep disabled for private/hidden tests.
# Enable only with an operator-managed HTTPS endpoint and secret-file API key.
#JUDGE0_ENABLED=false
#JUDGE_ASYNC_EXECUTOR=docker
#JUDGE0_ENDPOINT=https://judge0.example.invalid
#JUDGE0_API_KEY=<secret-store>
#JUDGE0_API_KEY_HEADER=X-Auth-Token
#JUDGE0_POLL_INTERVAL_MS=250
#JUDGE0_REQUEST_TIMEOUT_MS=10000
#JUDGE0_MAX_OUTPUT_BYTES=65536
#JUDGE0_LANGUAGE_IDS_PYTHON=71
#JUDGE0_LANGUAGE_IDS_JAVA=62
#JUDGE0_LANGUAGE_IDS_CPP=54
#JUDGE0_LANGUAGE_IDS_C=50
#JUDGE0_LANGUAGE_IDS_JAVASCRIPT=63
# Optional managed data-layer overrides. Keep local defaults self-hosted; set
# VERIFY_IDENTITY and a truststore/CA in each owner's secret file for managed MySQL.
#AUTH_DB_URL=jdbc:mysql://db.example.invalid/auth?sslMode=VERIFY_IDENTITY
#ADMIN_DB_URL=jdbc:mysql://db.example.invalid/admin?sslMode=VERIFY_IDENTITY
#APP_DB_URL=jdbc:mysql://db.example.invalid/app?sslMode=VERIFY_IDENTITY
#SUBMISSION_DB_URL=jdbc:mysql://db.example.invalid/submission?sslMode=VERIFY_IDENTITY
#NOTIFICATION_DB_URL=jdbc:mysql://db.example.invalid/notification?sslMode=VERIFY_IDENTITY
#AUTH_DB_SSL_MODE=VERIFY_IDENTITY
#ADMIN_DB_SSL_MODE=VERIFY_IDENTITY
#APP_DB_SSL_MODE=VERIFY_IDENTITY
#SUBMISSION_DB_SSL_MODE=VERIFY_IDENTITY
#NOTIFICATION_DB_SSL_MODE=VERIFY_IDENTITY
# Auth Redisson uses the rediss:// URL plus its own truststore settings.
#AUTH_REDIS_SSL_ENDPOINT_IDENTIFICATION_ENABLED=true
#AUTH_REDIS_SSL_TRUSTSTORE=/run/secrets/auth-redis-truststore.p12
#AUTH_REDIS_SSL_TRUSTSTORE_PASSWORD=<secret-store>
# Each owner uses its own managed Redis URL and TLS switch. Configure the
# standard Spring Boot bundle property only when the matching bundle exists.
# When a URL is supplied, Spring Boot uses its userinfo for credentials;
# URL-encode any reserved characters in the username/password.
#AUTH_REDIS_URL=rediss://ulticode-auth:<secret-store>@redis.example.invalid:6380/0
#AUTH_REDIS_SSL_ENABLED=true
#SPRING_DATA_REDIS_SSL_BUNDLE=managed-redis
#ADMIN_REDIS_URL=rediss://ulticode-admin:<secret-store>@redis.example.invalid:6380/1
#ADMIN_REDIS_SSL_ENABLED=true
#APP_REDIS_URL=rediss://ulticode-app:<secret-store>@redis.example.invalid:6380/2
#APP_REDIS_SSL_ENABLED=true
#SUBMISSION_REDIS_URL=rediss://ulticode-submission:<secret-store>@redis.example.invalid:6380/3
#SUBMISSION_REDIS_SSL_ENABLED=true
#NOTIFICATION_REDIS_URL=rediss://ulticode-notification:<secret-store>@redis.example.invalid:6380/4
#NOTIFICATION_REDIS_SSL_ENABLED=true
#SEARCH_REDIS_URL=rediss://ulticode-search:<secret-store>@redis.example.invalid:6380/5
#SEARCH_REDIS_SSL_ENABLED=true
#JUDGE_REDIS_URL=rediss://ulticode-judge:<secret-store>@redis.example.invalid:6380/6
#JUDGE_REDIS_SSL_ENABLED=true
# Sandbox (D-form) — image must be built locally, see
# CLAUDE.md § Sandbox Harness. Under local PM2 SANDBOX_ENABLED has NO effect
# on execution (the executor keys off sandbox.executor, default docker); it is
# a historical placeholder, keep false. The production compose Judge Worker
# forwards every SANDBOX_* variable to the container and defaults
# SANDBOX_ENABLED=true, so on the deployment host these values are live
# tuning knobs (memory/cpus/timeout/pids-limit). PM2 keeps the repository-root
# relative seccomp value above for local launches; production Compose instead
# derives an absolute profile path from SANDBOX_HOST_DIR/seccomp-profile.json.
# A production deployment must not use the PM2-relative value because the
# remote daemon resolves the path on its own host.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=ulticode-sandbox:latest
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1.0
SANDBOX_TIMEOUT=10
SANDBOX_PIDS_LIMIT=128
SANDBOX_SECCOMP_PROFILE=docker/sandbox/seccomp-profile.json
# Production Compose Judge Worker only: use a dedicated remote/rootless Docker
# daemon over mutual TLS. The host directory must contain ca.pem, cert.pem and
# key.pem; do not put these files in Git.
#JUDGE_DOCKER_HOST=tcp://sandbox-daemon.example.internal:2376
#JUDGE_DOCKER_CERT_DIR=/etc/ulticode/judge-docker
# The remote daemon and Judge worker must share this path (for example via an
# operator-managed shared filesystem) so child-container mounts resolve safely.
SANDBOX_HOST_DIR=/opt/ulticode/sandbox
# Development-only socket profile (`docker-compose.judge-dev.yml`; never
# include it in production). The production Compose has no socket fallback.
DOCKER_GID=999
BACKUP_DIR=/tmp/ulticode-backups
# External owner backup runbook inputs are required only when invoking
# scripts/runbooks/owner-backup-restore.sh; keep the DB credential/key out of
# this app runtime environment and the repository.
OWNER_BACKUP_RETENTION_DAYS=30
AUDIT_EXPORT_LIMIT=10000

# One-time administrator bootstrap. Keep disabled during normal startup.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Fixed credentials for the disposable local development database only.
DEV_SEED_USERS_ENABLED=true
DEV_SEED_ADMIN_USERNAME=admin
DEV_SEED_ADMIN_EMAIL=admin@localhost.test
DEV_SEED_ADMIN_PASSWORD=admin123
DEV_SEED_ADMIN_ROLE=ADMIN

# Optional integrations are disabled until real local credentials are supplied.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:9002/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9002/api/auth/google/callback
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ENABLED=false
EMAIL_FROM_NAME=UltiCode Dev

# Frontend
VITE_API_BASE_URL=/api
VITE_ADMIN_BASE_URL=http://localhost:9003
VITE_TEST_USERNAME=admin
VITE_TEST_PASSWORD=admin123
