# Prevent a common accidental secret dump; this is not a data-loss-prevention scanner.

for wrapper in [[], ["rtk"], ["rtk", "proxy"]]:
    prefix_rule(
        pattern = wrapper + ["cat",[".env","./.env"]],
        decision = "forbidden",
        justification = "Do not print runtime secrets; inspect .env.example or narrowly redacted values.",
        match = [" ".join(wrapper + ["cat",".env"])],
        not_match = [" ".join(wrapper + ["cat",".env.example"])],
    )
