# Narrow tripwires for remote publication and common destructive Git forms.

for wrapper in [[], ["rtk"], ["rtk", "proxy"]]:
    prefix_rule(
        pattern = wrapper + ["git","push"],
        decision = "prompt",
        justification = "Confirm the authorized remote and refs; this changes remote state.",
        match = [" ".join(wrapper + ["git","push","origin","main"])],
        not_match = [" ".join(wrapper + ["git","status"])],
    )
    prefix_rule(
        pattern = wrapper + ["git","reset","--hard"],
        decision = "prompt",
        justification = "Hard reset discards work; the exact target must be authorized.",
        match = [" ".join(wrapper + ["git","reset","--hard","HEAD~1"])],
        not_match = [" ".join(wrapper + ["git","reset","--soft","HEAD~1"])],
    )
    prefix_rule(
        pattern = wrapper + ["git","clean",["-f","-fd","-df","-fx","-fdx","-fxd","-xdf","--force"]],
        decision = "prompt",
        justification = "Forced clean deletes untracked work; review targets and authorization.",
        match = [" ".join(wrapper + ["git","clean","-fd"])],
        not_match = [" ".join(wrapper + ["git","clean","-nd"])],
    )
    prefix_rule(
        pattern = wrapper + ["git","checkout","--"],
        decision = "prompt",
        justification = "Path checkout discards local changes; require authorization for these paths.",
        match = [" ".join(wrapper + ["git","checkout","--","src/file"])],
        not_match = [" ".join(wrapper + ["git","checkout","feature"])],
    )
