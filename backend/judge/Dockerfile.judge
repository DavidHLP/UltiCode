# Multi-stage Dockerfile for secure code execution sandbox
# Supports: JavaScript, TypeScript, Python, Java, C++, Go

FROM ubuntu:22.04 AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    build-essential \
    openjdk-17-jdk \
    python3 \
    python3-pip \
    golang-go \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -s /bin/bash judge

# Set up working directory
WORKDIR /sandbox

# Create directories for code execution
RUN mkdir -p /sandbox/code /sandbox/input /sandbox/output /sandbox/runners \
    && chown -R judge:judge /sandbox

# Copy runner scripts
COPY runners/ /sandbox/runners/
RUN chmod +x /sandbox/runners/*.sh /sandbox/runners/*.py /sandbox/runners/*.js 2>/dev/null || true

# Switch to non-root user
USER judge

# Default command
CMD ["/bin/bash"]
