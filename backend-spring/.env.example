# Backend development uses the repository root `.env`.
#
# From the repository root:
#
#   ./scripts/dev/init-env.sh
#   ./scripts/dev/up.sh
#
# PM2 loads the root file through `ecosystem.config.cjs`. For direct Maven runs:
#
#   set -a
#   source ../.env
#   set +a
#   ./mvnw spring-boot:run -Dmaven.test.skip=true
#
# See `../.env.example` and `../docs/ENV.md` for the complete variable reference.
