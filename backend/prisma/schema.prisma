// Prisma Schema - Generated from TypeORM entities
// Run: npx prisma migrate dev to apply changes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MODULE
// ============================================================================
model User {
  id       String  @id @db.VarChar(40)
  username String  @unique @db.VarChar(120)
  name     String? @db.VarChar(120)
  email    String? @db.VarChar(255)
  avatar   String? @db.VarChar(255)
  password String? @db.VarChar(255)

  // Profile fields
  bio       String?  @db.Text
  website   String?  @db.VarChar(255)
  github    String?  @db.VarChar(255)
  twitter   String?  @db.VarChar(255)
  location  String?  @db.VarChar(255)
  company   String?  @db.VarChar(255)
  joined_at DateTime @default(now())

  solutions        Solution[]
  solutionComments SolutionComment[]
  edgeOperations   EdgeOperation[]
  submissions      Submission[]
  contestRankings ContestRanking[]
  contestParticipants ContestParticipant[]
  views View[]
  problemNotes ProblemNote[]
  collections Collection[]

  @@map("users")
}

// ============================================================================
// PROBLEM MODULE
// ============================================================================
enum Difficulty {
  Easy
  Medium
  Hard
}

enum ProblemStatus {
  solved
  attempted
  todo
}

model Problem {
  id              BigInt        @id
  slug            String        @db.VarChar(120)
  title           String        @db.VarChar(255)
  difficulty      Difficulty
  acceptance_rate Decimal       @default(0) @db.Decimal(5, 2)
  status          ProblemStatus @default(todo)
  is_premium      Boolean       @default(false)
  has_solution    Boolean       @default(false)
  completed_time  DateTime?     @db.Date

  detail       ProblemDetail?
  tagRelations ProblemTagRelation[]
  languages    ProblemLanguage[]
  examples     ProblemExample[]
  contestProblems ContestProblem[]
  solutions    Solution[]
  submissions  Submission[]
  problemNotes ProblemNote[]
  problemListRelations ProblemListProblemRelation[]

  @@map("problems")
}

model ProblemDetail {
  id                String   @id @db.VarChar(40)
  problem_id        BigInt   @unique
  slug              String   @db.VarChar(120)
  summary           String   @db.Text
  companies         Json?
  likes             Int      @default(0)
  dislikes          Int      @default(0)
  difficulty_rating Decimal  @default(1500) @db.Decimal(5, 1)
  updated_at        DateTime
  follow_up         String?  @db.Text
  constraints_json  Json
  hints             Json?

  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@map("problem_details")
}

model ProblemTag {
  id    String @id @db.VarChar(40)
  label String @db.VarChar(120)

  problemRelations ProblemTagRelation[]

  @@map("problem_tags")
}

model ProblemTagRelation {
  problem_id BigInt
  tag_id     String @db.VarChar(40)

  problem Problem    @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  tag     ProblemTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([problem_id, tag_id])
  @@map("problem_tag_relations")
}

model ProblemLanguage {
  id           String @id @db.VarChar(40)
  problem_id   BigInt
  label        String @db.VarChar(50)
  value        String @db.VarChar(50)
  starter_code String @db.Text

  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@map("problem_languages")
}

model ProblemExample {
  id            String  @id @db.VarChar(40)
  problem_id    BigInt
  example_order Int     @default(0)
  input_text    String  @db.Text
  output_text   String  @db.Text
  explanation   String? @db.Text
  inputs        Json?

  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@map("problem_examples")
}

// ============================================================================
// CONTEST MODULE
// ============================================================================
enum ContestType {
  weekly
  biweekly
  special
}

enum ContestStatus {
  upcoming
  running
  finished
}

model Contest {
  id                String        @id @db.VarChar(40)
  title             String        @db.VarChar(120)
  slug              String        @db.VarChar(120)
  contest_type      ContestType
  start_time        DateTime
  duration_minutes  Int
  status            ContestStatus
  registered_count  Int           @default(0)
  participant_count Int           @default(0)
  is_rated          Boolean       @default(true)
  description       String?       @db.Text
  cover_image       String?       @db.VarChar(255)

  problems ContestProblem[]
  rankings ContestRanking[]
  participants ContestParticipant[]

  @@map("contests")
}

model ContestProblem {
  id               String @id @db.VarChar(40)
  contest_id       String @db.VarChar(40)
  problem_id       BigInt
  problem_index    String @db.VarChar(10)
  score            Int    @default(0)
  solved_count     Int    @default(0)
  submission_count Int    @default(0)

  contest Contest @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@map("contest_problems")
}

model GlobalRanking {
  id               String  @id @db.VarChar(40)
  user_id          String  @unique @db.VarChar(40)
  username         String  @db.VarChar(120)
  global_rank      Int
  rating           Int     @default(1500)
  max_rating       Int     @default(1500)
  contests_attended Int    @default(0)
  avatar           String? @db.VarChar(255)
  country          String  @default("CN") @db.VarChar(10)
  badge            String? @db.VarChar(50)

  @@map("global_rankings")
}

model ContestRanking {
  id                  String @id @db.VarChar(40)
  contest_id          String @db.VarChar(40)
  user_id             String @db.VarChar(40)
  username            String @db.VarChar(120)
  rank                Int
  score               Int
  finish_time_seconds Int
  q1_time_seconds     Int?
  q2_time_seconds     Int?
  q3_time_seconds     Int?
  q4_time_seconds     Int?
  rating_before       Int
  rating_after        Int
  rating_change       Int
  country             String @default("CN") @db.VarChar(10)

  contest Contest @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("contest_rankings")
}

model ContestParticipant {
  id                  String    @id @db.VarChar(40)
  contest_id          String    @db.VarChar(40)
  user_id             String    @db.VarChar(40)
  username            String    @db.VarChar(120)
  status              String    @db.VarChar(20) // registered, participated, virtual
  registered_at       DateTime
  started_at          DateTime?
  finished_at         DateTime?
  rank                Int?
  score               Int       @default(0)
  finish_time_seconds Int?
  is_virtual          Boolean   @default(false)

  contest Contest @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("contest_participants")
}


// ============================================================================
// FORUM MODULE
// ============================================================================
model ForumCommunity {
  id          String @id @db.VarChar(40)
  name        String @db.VarChar(120)
  slug        String @db.VarChar(60)
  description String @db.Text
  members     Int    @default(0)
  online      Int    @default(0)

  posts ForumPost[]

  @@map("forum_communities")
}

model ForumUser {
  id       String  @id @db.VarChar(40)
  username String  @unique @db.VarChar(60)
  avatar   String? @db.VarChar(255)
  karma    Int     @default(0)

  posts    ForumPost[]
  comments ForumComment[]

  @@map("forum_users")
}

enum FlairType {
  announcement
  discussion
  showcase
  question
  hiring
}

enum VoteState {
  upvoted
  downvoted
  neutral
}

model ForumPost {
  id             String    @id @db.VarChar(40)
  community_id   String    @db.VarChar(40)
  user_id        String    @db.VarChar(40)
  permalink      String?   @db.VarChar(255)
  title          String    @db.VarChar(255)
  flair_type     FlairType?
  flair_label    String?   @db.VarChar(60)
  tags           Json
  excerpt        String?   @db.Text
  media          Json?
  recommendation Json?
  vote_state     VoteState @default(neutral)
  is_saved       Boolean   @default(false)
  impressions    Int       @default(0)
  views          Int       @default(0)
  is_pinned      Boolean   @default(false)
  is_locked      Boolean   @default(false)
  created_at     DateTime
  stats          Json?


  community ForumCommunity @relation(fields: [community_id], references: [id], onDelete: Cascade)
  author    ForumUser      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comments  ForumComment[]

  @@map("forum_posts")
}

model ForumComment {
  id         String    @id @db.VarChar(40)
  post_id    String    @db.VarChar(40)
  parent_id  String?   @db.VarChar(40)
  author_id  String    @db.VarChar(40)
  body       String    @db.Text
  markdown   String?   @db.Text

  created_at DateTime
  edited_at  DateTime?
  is_pinned  Boolean   @default(false)
  is_locked  Boolean   @default(false)

  post   ForumPost     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  parent ForumComment? @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  author ForumUser     @relation(fields: [author_id], references: [id], onDelete: Cascade)

  replies ForumComment[] @relation("CommentReplies")

  @@map("forum_comments")
}

// ============================================================================
// PROBLEM LIST MODULE
// ============================================================================

// 题单表：每个题单有作者，可以是公开或私有的
model ProblemList {
  id          String   @id @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  author_id   String   @db.VarChar(40)
  is_public   Boolean  @default(true)
  is_featured Boolean  @default(false) // 是否为系统推荐题单
  created_at  DateTime
  updated_at  DateTime

  problemRelations ProblemListProblemRelation[]

  @@map("problem_lists")
}

// 题单与问题的关联
model ProblemListProblemRelation {
  list_id    String   @db.VarChar(50)
  problem_id BigInt
  sort_order Int      @default(0)
  added_at   DateTime @default(now())

  list    ProblemList @relation(fields: [list_id], references: [id], onDelete: Cascade)
  problem Problem     @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@id([list_id, problem_id])
  @@map("problem_list_problem_relations")
}

// ============================================================================
// COLLECTION MODULE (通用收藏夹系统)
// ============================================================================

// 用户收藏夹
model Collection {
  id          String   @id @default(uuid()) @db.VarChar(40)
  user_id     String   @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  color       String?  @db.VarChar(20)
  sort_order  Int      @default(0)
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user  User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@unique([user_id, name])
  @@index([user_id])
  @@index([user_id, is_default])
  @@map("collections")
}

// 收藏夹项目（支持多种内容类型）
model CollectionItem {
  id            String               @id @default(uuid()) @db.VarChar(40)
  collection_id String               @db.VarChar(40)
  target_id     String               @db.VarChar(40)
  target_type   CollectionTargetType
  sort_order    Int                  @default(0)
  note          String?              @db.Text
  created_at    DateTime             @default(now())

  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)

  @@unique([collection_id, target_type, target_id])
  @@index([target_type, target_id])
  @@map("collection_items")
}

enum CollectionTargetType {
  PROBLEM
  SOLUTION
  FORUM_POST
  PROBLEM_LIST
}

// ============================================================================
// SOLUTION MODULE
// ============================================================================
model Solution {
  id         String   @id @db.VarChar(40)
  problem_id BigInt
  user_id    String   @db.VarChar(40)
  title      String   @db.VarChar(255)
  content    String   @db.Text
  summary    String?  @db.Text
  language   String   @db.VarChar(50)
  tags       Json?
  views      Int      @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  problem  Problem           @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  author   User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comments SolutionComment[]


  @@map("solutions")
}

model SolutionComment {
  id          String   @id @db.VarChar(40)
  solution_id String   @db.VarChar(40)
  parent_id   String?  @db.VarChar(40)
  user_id     String   @db.VarChar(40)
  content     String   @db.Text

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  solution Solution          @relation(fields: [solution_id], references: [id], onDelete: Cascade)
  author   User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent   SolutionComment?  @relation("SolutionCommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies  SolutionComment[] @relation("SolutionCommentReplies")

  @@map("solution_comments")
}

model EdgeOperation {
  id             String                  @id @default(uuid()) @db.VarChar(40)
  target_id      String                  @db.VarChar(40)
  target_type    EdgeOperationTargetType
  operator_id    String                  @db.VarChar(40)
  operation_type EdgeOperationType
  created_at     DateTime                @default(now())

  operator User @relation(fields: [operator_id], references: [id], onDelete: Cascade)

  @@unique([operator_id, operation_type, target_type, target_id], map: "edge_ops_unique")
  @@index([target_type, target_id], map: "edge_ops_target")
  @@index([operation_type, target_type, target_id], map: "edge_ops_operation_target")
  @@map("edge_operations")
}

enum EdgeOperationType {
  VOTE_UP
  VOTE_DOWN
  FAVORITE
  ANALYZE
}

enum EdgeOperationTargetType {
  SOLUTION
  SOLUTION_COMMENT
  FORUM_POST
  FORUM_COMMENT
  PROBLEM
  PROBLEM_LIST
}

model ProblemNote {
  id         String   @id @default(uuid()) @db.VarChar(40)
  problem_id BigInt
  user_id    String   @db.VarChar(40)
  content    String   @db.Text
  updated_at DateTime @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@unique([user_id, problem_id])
  @@map("problem_notes")
}

// ============================================================================
// SUBMISSION MODULE
// ============================================================================
model Submission {
  id                String   @id @db.VarChar(40)
  problem_id        BigInt
  user_id           String   @db.VarChar(40)
  language          String   @db.VarChar(50)
  code              String   @db.Text
  status            String   @db.VarChar(20) // Accepted, Wrong Answer, TLE, RE, etc.
  runtime           Int // milliseconds
  memory            Float // megabytes
  notes             String?  @db.Text
  created_at        DateTime @default(now())

  // Performance stats
  runtime_percentile Float? // e.g. 85.5 (beats 85.5%)
  memory_percentile  Float? // e.g. 40.2 (beats 40.2%)

  // Detailed results
  test_details      Json?
  runtimeDistBinsMs Json?
  memoryDistBinsMb  Json?

  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([problem_id, user_id])
  @@map("submissions")
}

// ============================================================================
// VIEW TRACKING MODULE
// ============================================================================

model View {
  id          String         @id @default(uuid()) @db.VarChar(40)
  target_id   String         @db.VarChar(40)
  target_type ViewTargetType
  user_id     String?        @db.VarChar(40) // Optional (for guests)
  ip          String?        @db.VarChar(45) // IPv6 support
  viewed_at   DateTime       @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([target_type, target_id, user_id, ip]) // For fast existence checks
  @@map("views")
}

enum ViewTargetType {
  SOLUTION
  FORUM_POST
}
