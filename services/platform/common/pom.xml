<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.ulticode</groupId>
		<artifactId>ulticode-backend</artifactId>
		<!-- ${revision}: reactor-wide platform version; deployable services override
	     their own release version below via service.version.* -->
		<version>${revision}</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>backend-common</artifactId>
	<name>UltiCode Backend (shared common)</name>
	<description>
		Phase 1 (P1-INFRA-002) shared contract module. Holds the dependency-free
		HTTP envelope (Result, PageResult, PaginationRequest), RPC envelope
		(RpcResult), namespaced error-code base types, and trace/id metadata.
		Must NOT depend on MyBatis, JPA, Spring beans, Entity, Mapper, or
		ServiceImpl implementations.
	</description>

	<dependencies>
		<!--
		  Jackson annotations (@JsonInclude on Result) — managed by
		  spring-boot-starter-parent in the reactor BOM, so no explicit
		  version is needed. No JSON parser/databind is required; legacy
		  and downstream modules continue to provide the runtime.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>

		<!--
		  Lombok is optional but the moved Result / PageResult are
		  annotated with @Data. Leaving it as a true compile dep keeps
		  the existing POJO surface stable without rewriting the moved
		  classes to manual getters/setters.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
		  Test surface. archunit-junit5 enforces "no MyBatis / no
		  Spring beans / no business impl" on the module itself, which
		  is the architectural gate for P1-INFRA-002.
		-->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Moved-from-app-api event-contract round-trip test uses ObjectMapper. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.2.0</version>
			<scope>test</scope>
		</dependency>


		<!--
		  WorkerSloMeters: plain-Micrometer gauge/counter set shared by the
		  Redis Streams workers (search, notification, judge). No Spring
		  annotations and no Redis client dependency, so the backend-common
		  architecture gate still holds.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-core</artifactId>
		</dependency>
</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-surefire-plugin</artifactId>
			<configuration>
				<!--
				  backend-common carries no jacoco agent, so the parent's
				  @{argLine} placeholder is never resolved and would be
				  passed to the forked JVM as the literal '@{argLine}'
				  (which crashes `java -jar`). The plain attach flag is
				  enough to make ByteBuddy's inline mock maker usable
				  under JDK 17.0.2.
				-->
				<argLine>-Djdk.attach.allowAttachSelf=true</argLine>
			</configuration>
		</plugin>
	</plugins>
	</build>
</project>
