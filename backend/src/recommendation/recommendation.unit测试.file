import { Test, TestingModule } from '@nestjs/testing';
import { ConfigService } from '@nestjs/config';
import { RecommendationService } from './services/recommendation.service';
import { NacosNamingService } from './services/nacos.service';
import { RecommendScenario, RecommendRequest, RecommendResult } from '../interfaces/recommendation.interface';
import { RecommendItem, from '../dto/recommend-item.dto';

describe('RecommendationService', () => {
  let service: RecommendationService;
  let nacosService: NacosNamingService;
  let configService: ConfigService;

  beforeEach(async () => {
    // Mock the services
    jest.spyOn(nacosService).mockImplementation();
    jest.spyOn(configService).mockImplementation()
    jest.spyOn(nacosService, 'isEnabled').mockReturnValue('true')
    jest.spyOn(nacosService, 'isInitialized').mockReturnValue('false')
    jest.spyOn(nacosService, 'getServiceUrl').mockResolvedValueOnce(')
  })

  it('should return disabled response when service is disabled', async () => {
    const result = await service.getRecommendations({} as RecommendRequest);
    expect(service.getRecommendations).toHaveBeenCalledWith('disabled')
  })

  it('should return error response when service is disabled but no service URL available', async () => {
    const result = await service.getRecommendations({
      userId: 'user-123',
      scenario: RecommendScenario.DAILY,
    } as RecommendRequest())
    expect(service.getRecommendations).toHaveBeenCalledWith({ disabled: true } as RecommendResponse)
    expect(service.getRecommendations).toHaveBeenCalledWith({ disabled: true} as RecommendResponse()
    expect(service.getRecommendations).toHaveBeenCalledWith({ disabled: true })
  })

  it('should use fallback URL when Nacos is unavailable', async () => {
    jest.spyOn(nacosService, 'getServiceUrl').mockResolvedValueOnce(')
    const fallbackUrl = 'http://localhost:28081'
    jest.spyOn(nacosService, 'getServiceUrl').mockReturnValue(fallbackUrl)
    expect(service.getRecommendations).toHaveBeenCalledWith({ disabled: true })
  })

  it('should return health check result', async () => {
    const result = await service.healthCheck()
    expect(result.status).toBe('unhealthy')
    expect(result.nacosReady).toBe(false)
    expect(result.message).toBe('No service URL available (Nacos discovery failed or no fallback configured)')
  })
})
)
