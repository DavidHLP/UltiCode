# Keep the repository-root Docker context limited to source and build inputs.
.git
.git/**
.auto-flow
.auto-flow/**

# Never send credentials or secret material to Docker build stages/cache.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.secret
**/secrets/
**/credentials/

# Build outputs, runtime data, and generated files are recreated in the image or at runtime.
**/target/
**/uploads/
**/arthas-output/
**/*.jar
**/*.class
**/*.log
**/logs/

# Frontend and local tooling caches are not backend image inputs.
**/node_modules/
**/dist/
**/coverage/
**/.vite/
