  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "reka-ui": "^2.9.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.4",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.10"
  }
}
