{
  // Inlined from `@vue/tsconfig` (^0.7.0) — see
  // node_modules/@vue/tsconfig/{tsconfig.json,tsconfig.dom.json}.
  // We inline instead of `extends` because the Docker build context for
  // apps do not install packages/sidebar-menu dependencies, so
  // oxc fails to resolve `@vue/tsconfig` and reports "Tsconfig not found"
  // for every .vue file under packages/sidebar-menu. Mirroring the config keeps
  // local dev and CI builds identical.
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "noImplicitThis": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "libReplacement": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "vue": ["../../console/node_modules/vue"],
      "reka-ui": ["../../console/node_modules/reka-ui"],
      "vue-router": ["../../console/node_modules/vue-router"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
