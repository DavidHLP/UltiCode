# =====================================================================
# 反选法（白名单机制） .gitignore
# =====================================================================
# 设计理念：
#   1. `*` 全局拒绝所有文件（无论层级）
#   2. `!*/` 放行所有目录，允许 Git 递归遍历
#   3. `!path/**` 逐棵放行需要跟踪的目录树
#   4. 白名单目录内用常规黑名单排除构建产物
#
# 优势：新生成的临时文件 / 缓存不会被误 `git add`；
#       新目录必须显式注册才能进入版本控制，不会漏审。
# =====================================================================


# =====================================================================
# 1. 全局默认拒绝 + 目录放行
# =====================================================================
*
!*/

# =====================================================================
# 2. 项目根目录文件
# =====================================================================
!/.gitignore
!/.gitlab-ci.yml
!/.gitleaks.toml
!/.mcp.json
!/PROJECT_DOCUMENTATION.md
!/AGENTS.md
!/CLAUDE.md
!/CONTEXT.md
!/LICENSE
!/README.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/pitstop.yaml
!/ecosystem.config.cjs
!/.dockerignore
!/docker-compose.yml
!/docker-compose.dev.yml
!/docker-compose.prod.yml
!/docker-compose.ci.yml
!/docker-compose.gateway-test.yml
!/.env.example
!/.env.test.example
!/.auto-flow/**

# =====================================================================
# 3. 后端 (Spring Boot / Java 17)
# =====================================================================
!services/**
services/**/target/
services/arthas-output/
services/com/
services/*.jar
services/*.class
services/.settings/
services/.classpath/
services/.factorypath/
services/.project/
services/*.iml
services/auth/**/target/
services/auth/**/uploads/
services/auth/**/arthas-output/
services/auth/**/*.jar
services/auth/**/*.class
services/admin/**/target/
services/admin/**/uploads/
services/admin/**/arthas-output/
services/admin/**/*.jar
services/admin/**/*.class
services/app/**/target/
services/app/**/uploads/
services/app/**/arthas-output/
services/app/**/*.jar
services/app/**/*.class

# =====================================================================
# 3a. Owner secret material exclusion (owners now under services/)
# =====================================================================
services/**/.env*
services/**/*.pem
services/**/*.key
services/**/*.p12
services/**/*.jks
services/**/*.secret
services/**/secrets/
services/**/credentials/

# =====================================================================
# 4. 用户端前端 (Vue 3 / apps/console)
# =====================================================================
!apps/**
apps/*/dist/
apps/*/node_modules/
apps/*/*.local
apps/*/.vite/
apps/*/.cache/
apps/*/.vitest/
apps/*/coverage/
apps/*/.eslintcache
apps/*/.stylelintcache
apps/*/.tsbuildinfo
apps/*/dist-ssr/

# =====================================================================
# 5. 共享包 (packages/)
# =====================================================================
!packages/**
packages/*/node_modules/
packages/*/dist/
packages/*/coverage/
packages/*/.vite/
packages/*/.vitest/
packages/*/.tsbuildinfo

# =====================================================================
# 7. 数据库迁移 (init-db/)
# =====================================================================
!init-db/**
init-db/target/
init-db/project-local-repo/

# =====================================================================
# 8. 基础设施与 Docker 沙箱
# =====================================================================
!docker/**
docker/sandbox/harness-staging/
!infrastructure/**

# =====================================================================
# 9. 开发与运维脚本
# =====================================================================
!scripts/**

# =====================================================================
# 10. Consolidated project documentation
# =====================================================================

# =====================================================================
# 11. 静态资源（截图等）
# =====================================================================
!assets/**

# =====================================================================
# 12. 工具链（Arthas 等）
# =====================================================================
!tools/**

# =====================================================================
# 13. AI 工具配置（团队共享，纳入版本控制）
# =====================================================================
!.claude/**
.claude/memory/
.claude/reviews/
.claude/PRPs/
.claude/.arthas/
.claude/settings.local.json
.claude/worktrees/

# Pi coding agent rules (mirror of .claude/rules/ for Pi's pi-rules extension)
!.pi/rules/**
# Pi extension runtime state (queue, locks, logs) — never tracked
.pi/.pi-rules/

!.codex/**
!.cursor/**
!.github/**
!.rtk/**
!.serena/**

# =====================================================================
# 14. 环境变量与密钥
# =====================================================================
.env
.env.*
!.env.example
!.env.test.example

# =====================================================================
# 15. 依赖目录
# =====================================================================
node_modules/
**/node_modules/

# =====================================================================
# 16. 日志
# =====================================================================
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# =====================================================================
# 17. AI 会话缓存 / 运行时状态（无需跟踪）
# =====================================================================
.omo/
.codebase-memory/
.codegraph
.vfox/
.vfox.toml
.tool-versions
.zcode/
.reports/

# =====================================================================
# 18. IDE / 编辑器
# =====================================================================
.idea/
.vscode/
*.iws
*.iml
*.ipr
*.swp
*.swo
*~
.c9/
.settings/
.classpath
.project
.factorypath
*.launch
*.sublime-workspace

# =====================================================================
# 19. 操作系统与临时文件
# =====================================================================
.DS_Store
Thumbs.db
.temp
.tmp
*.pid
*.pid.lock
*.seed
worktrees/
.worktrees/

# =====================================================================
# 19c. 运行时临时状态（与 AGENTS.md 的 .scratch 约定对齐）
# =====================================================================
**/.scratch/
**/*.heapsnapshot
**/*.heap
**/perf-*.json

# =====================================================================
# 20. 测试覆盖率报告
# =====================================================================
coverage/
.htmlcov/
.nyc_output

# =====================================================================
# 21. Maven / 构建缓存
# =====================================================================
.gradle/
*.class
*.jar
*.war
*.ear

# =====================================================================
# 22. 编译器 / 构建缓存（出现在白名单目录内时需显式忽略）
# =====================================================================
*.tsbuildinfo
dist-ssr/
.eslintcache
.stylelintcache
.vite-inspect
*.local
*.log.gz
.help.md
# Maven reactor 根级编译产物泄漏（异常输出到 cwd 而非 target/）
backend-spring/com/

# =====================================================================
# 23. 杂项
# =====================================================================
mempalace.yaml
entities.json
.antigravitycli
.playwright-mcp
.pytest_cache/
.mypy_cache/
.tox/
*.egg-info/
*.py[cod]
__pycache__/
venv/
.env/
.venv/
disposable-verify/
