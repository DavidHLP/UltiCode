{
  "name": "edit-markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run lint && pnpm run type-check && pnpm run format && pnpm run test && vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "validate:mocks": "node scripts/validate-mock-data.mjs",
    "validate:mocks:verbose": "node scripts/validate-mock-data.mjs --verbose",
    "validate:mocks:strict": "node scripts/validate-mock-data.mjs --strict"
  },
  "dependencies": {
    "@internationalized/date": "^3.10.0",
    "@monaco-editor/loader": "^1.7.0",
    "@stomp/stompjs": "^7.3.0",
    "@tabler/icons-vue": "^3.44.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-virtual": "^3.13.18",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "@vue-dnd-kit/core": "^1.7.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.3",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "katex": "^0.16.47",
    "lucide-vue-next": "^0.552.0",
    "markdown-it": "^14.1.0",
    "markdown-it-katex": "^2.0.3",
    "monaco-editor": "^0.52.2",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.7",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.25",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.102",
    "@iconify-json/radix-icons": "^1.2.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/node22": "^22.0.5",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.30.1",
    "eslint-plugin-vue": "^9.30.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "knip": "^6.4.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.3",
    "typescript": "~6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "maplibre-gl",
      "msw",
      "vue-demi"
    ]
  }
}
