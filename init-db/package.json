{
  "name": "@ulticode/init-db",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:seed:new": "cross-env USE_NEW_SEED=true prisma db seed",
    "db:seed:notifications": "ts-node scripts/seed-notifications-only.ts",
    "db:seed:announcements": "ts-node scripts/seed-system-announcements.ts",
    "type-check": "tsc --noEmit",
    "migration:create": "ts-node scripts/create-migration.ts",
    "migration:run": "ts-node scripts/run-migration.ts",
    "migration:status": "ts-node scripts/run-migration.ts --status",
    "migration:run:all": "ts-node scripts/run-migration.ts --all",
    "migration:run:dry": "ts-node scripts/run-migration.ts --all --dry-run"
  },
  "prisma": {
    "seed": "ts-node seeds/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.10.7",
    "cross-env": "^7.0.3",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
