# High-risk data and host mutations; ordinary local build/start/stop stays unclassified.

for wrapper in [[], ["rtk"], ["rtk", "proxy"]]:
    prefix_rule(
        pattern = wrapper + ["docker","compose","down",["-v","--volumes"]],
        decision = "prompt",
        justification = "Removing volumes can erase databases; confirm the disposable project and data scope.",
        match = [" ".join(wrapper + ["docker","compose","down","-v"])],
        not_match = [" ".join(wrapper + ["docker","compose","down"])],
    )
    prefix_rule(
        pattern = wrapper + ["docker","volume",["rm","prune"]],
        decision = "prompt",
        justification = "Volume deletion can erase persistent data; confirm the target scope.",
        match = [" ".join(wrapper + ["docker","volume","rm","ulticode_mysql"])],
        not_match = [" ".join(wrapper + ["docker","volume","ls"])],
    )
    prefix_rule(
        pattern = wrapper + ["docker","system","prune"],
        decision = "prompt",
        justification = "System prune affects host resources; confirm the cleanup scope.",
        match = [" ".join(wrapper + ["docker","system","prune"])],
        not_match = [" ".join(wrapper + ["docker","system","df"])],
    )
    prefix_rule(
        pattern = wrapper + ["flyway",["clean","repair"]],
        decision = "prompt",
        justification = "This removes schema data or changes migration history; confirm the target and recovery operation.",
        match = [" ".join(wrapper + ["flyway","clean"])],
        not_match = [" ".join(wrapper + ["flyway","info"])],
    )
    prefix_rule(
        pattern = wrapper + ["chmod","-R"],
        decision = "prompt",
        justification = "Recursive permission changes affect a whole tree; confirm the target.",
        match = [" ".join(wrapper + ["chmod","-R","755","scripts"])],
        not_match = [" ".join(wrapper + ["chmod","755","scripts/run.sh"])],
    )
    prefix_rule(
        pattern = wrapper + ["chown","-R"],
        decision = "prompt",
        justification = "Recursive ownership changes affect a whole tree; confirm the target.",
        match = [" ".join(wrapper + ["chown","-R","user:group","workspace"])],
        not_match = [" ".join(wrapper + ["chown","user:group","workspace/file"])],
    )
