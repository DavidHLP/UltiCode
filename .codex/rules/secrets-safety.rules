# Keep project secrets out of command output and avoid unsafe shell execution.

prefix_rule(
    pattern = ["cat", ".env"],
    decision = "forbidden",
    justification = "Do not print runtime secrets; inspect .env.example or a redacted, allowlisted value instead.",
    match = ["cat .env"],
    not_match = ["cat .env.example"],
)

prefix_rule(
    pattern = ["rtk", "cat", ".env"],
    decision = "forbidden",
    justification = "Do not print runtime secrets; inspect .env.example or a redacted, allowlisted value instead.",
    match = ["rtk cat .env"],
    not_match = ["rtk cat .env.example"],
)

prefix_rule(
    pattern = ["printenv"],
    decision = "prompt",
    justification = "Environment output can disclose credentials; prefer a narrowly selected, redacted variable.",
    match = ["printenv", "printenv PATH"],
    not_match = ["printf PATH"],
)

prefix_rule(
    pattern = ["rtk", "printenv"],
    decision = "prompt",
    justification = "Environment output can disclose credentials; prefer a narrowly selected, redacted variable.",
    match = ["rtk printenv PATH"],
    not_match = ["rtk printf PATH"],
)

prefix_rule(
    pattern = ["env"],
    decision = "prompt",
    justification = "Environment output or injected values can disclose credentials; use an explicit allowlist.",
    match = ["env", "env PATH=/usr/bin command"],
    not_match = ["envoy PATH=/usr/bin command"],
)

prefix_rule(
    pattern = ["rtk", "env"],
    decision = "prompt",
    justification = "Environment output or injected values can disclose credentials; use an explicit allowlist.",
    match = ["rtk env PATH=/usr/bin command"],
    not_match = ["rtk envoy PATH=/usr/bin command"],
)

prefix_rule(
    pattern = ["eval"],
    decision = "forbidden",
    justification = "Do not execute dynamically assembled shell strings; pass validated arguments as an array.",
    match = ["eval command"],
    not_match = ["command --help"],
)

prefix_rule(
    pattern = ["rtk", "eval"],
    decision = "forbidden",
    justification = "Do not execute dynamically assembled shell strings; pass validated arguments as an array.",
    match = ["rtk eval command"],
    not_match = ["rtk command --help"],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "prompt",
    justification = "Recursive deletion can cause data loss; confirm the exact narrow target and recovery path first.",
    match = ["rm -rf build"],
    not_match = ["rm build/file"],
)

prefix_rule(
    pattern = ["rtk", "rm", "-rf"],
    decision = "prompt",
    justification = "Recursive deletion can cause data loss; confirm the exact narrow target and recovery path first.",
    match = ["rtk rm -rf build"],
    not_match = ["rtk rm build/file"],
)

prefix_rule(
    pattern = ["rm", "-r"],
    decision = "prompt",
    justification = "Recursive deletion can cause data loss; confirm the exact narrow target and recovery path first.",
    match = ["rm -r build"],
    not_match = ["rm build/file"],
)

prefix_rule(
    pattern = ["rtk", "rm", "-r"],
    decision = "prompt",
    justification = "Recursive deletion can cause data loss; confirm the exact narrow target and recovery path first.",
    match = ["rtk rm -r build"],
    not_match = ["rtk rm build/file"],
)

prefix_rule(
    pattern = ["chmod", "-R"],
    decision = "prompt",
    justification = "Recursive permission changes can weaken or break the workspace; confirm the exact target first.",
    match = ["chmod -R 755 scripts"],
    not_match = ["chmod 755 scripts/run.sh"],
)

prefix_rule(
    pattern = ["rtk", "chmod", "-R"],
    decision = "prompt",
    justification = "Recursive permission changes can weaken or break the workspace; confirm the exact target first.",
    match = ["rtk chmod -R 755 scripts"],
    not_match = ["rtk chmod 755 scripts/run.sh"],
)

prefix_rule(
    pattern = ["chown", "-R"],
    decision = "prompt",
    justification = "Recursive ownership changes can affect the host and workspace; confirm the exact target first.",
    match = ["chown -R user:group workspace"],
    not_match = ["chown user:group workspace/file"],
)

prefix_rule(
    pattern = ["rtk", "chown", "-R"],
    decision = "prompt",
    justification = "Recursive ownership changes can affect the host and workspace; confirm the exact target first.",
    match = ["rtk chown -R user:group workspace"],
    not_match = ["rtk chown user:group workspace/file"],
)
