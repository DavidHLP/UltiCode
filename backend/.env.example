# Database connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development with Docker: mysql://ulticode:ulticode@localhost:23306/ulticode
DATABASE_URL="mysql://ulticode:ulticode@localhost:23306/ulticode"

# JWT secret for signing access tokens (15min expiry) and refresh tokens (7-day expiry)
# Must be at least 32 characters long for cryptographic security
# Generate a secure random string for production
JWT_SECRET="ulticode-super-secret-jwt-key-min-32-chars"

# Judge Container Configuration
# CRITICAL SECURITY: Set to 'true' for production deployment
# When 'false', the legacy vm module is used (CRITICAL SECURITY RISK - sandbox escape vulnerability)
# DO NOT deploy to production with this set to 'false'
JUDGE_CONTAINER_ENABLED=true

# Docker image name for the judge container
JUDGE_CONTAINER_IMAGE=ulticode-judge:latest

# Number of containers to keep in the pool for warm starts
JUDGE_CONTAINER_POOL_SIZE=5

# Maximum number of containers that can be created
JUDGE_CONTAINER_MAX_CONTAINERS=10

# Default time limit for code execution (milliseconds)
JUDGE_DEFAULT_TIME_LIMIT=2000

# Default memory limit for code execution (MB)
JUDGE_DEFAULT_MEMORY_LIMIT=256

# Docker socket path (default: /var/run/docker.sock)
DOCKER_SOCKET_PATH=/var/run/docker.sock
