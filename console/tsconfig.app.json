{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "../shared/auth-ui/src/**/*",
    "../shared/auth-ui/src/**/*.vue",
    "../shared/sidebar-menu/src/**/*",
    "../shared/sidebar-menu/src/**/*.vue",
    "../shared/markdown-utils/src/**/*",
    "../shared/http-client/src/**/*",
    "../shared/i18n-storage/src/**/*",
    "../shared/datetime-utils/src/**/*",
    "../shared/locale-composable/src/**/*"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/shared/*": [
        "../shared/*"
      ],
      "vue": [
        "./node_modules/vue"
      ],
      "vue-router": [
        "./node_modules/vue-router"
      ],
      "vue-i18n": [
        "./node_modules/vue-i18n"
      ],
      "axios": [
        "./node_modules/axios"
      ],
      "clsx": [
        "./node_modules/clsx"
      ],
      "tailwind-merge": [
        "./node_modules/tailwind-merge"
      ],
      "lucide-vue-next": [
        "./node_modules/lucide-vue-next"
      ],
      "reka-ui": [
        "./node_modules/reka-ui"
      ]
    }
  }
}
