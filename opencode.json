{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "experimental": {
    "mcp_lazy": true
  },
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": [
        "context-mode"
      ]
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "oh-my-openagent@latest",
    "context-mode",
    "@warp-dot-dev/opencode-warp"
  ],
  "permission": {
    "*": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "target/**",
      "*.class"
    ]
  },
  "lsp": true
}
